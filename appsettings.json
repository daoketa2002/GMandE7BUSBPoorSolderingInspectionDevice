{
  "AppSettings": {
    "AppName": "GM和E78_USB焊接不良检查装置系统",
    "Version": "1.0.0",
    "Theme": "Light",
    "AutoSave": true,
    "Volume": 50,
    "Notifications": true,
    "DebugMode": false
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console"
      },
      {
        "Name": "File",
        "Args": {
          "path": "logs/app-.log",
          "rollingInterval": "Day",
          "fileSizeLimitBytes": 10485760,
          "rollOnFileSizeLimit": true,
          "retainedFileCountLimit": 30,
          "shared": true
        }
      }
    ],
    "Enrich": [ "FromLogContext" ]
  },
  "PlanStorage": {
    "MaxSchemesPerFile": 500
  },
  "CsvStorage": {
    "RootPath": "Default",
    "MaxRowsPerFile": 50000,
    "Encoding": "UTF-8-BOM"
  }
}
