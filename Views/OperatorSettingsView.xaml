<UserControl x:Class="GMandE7BUSBPoorSolderingInspectionDevice.Views.OperatorSettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:GMandE7BUSBPoorSolderingInspectionDevice.Views"
             xmlns:vm="clr-namespace:GMandE7BUSBPoorSolderingInspectionDevice.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:OperatorSettingsViewModel}"
             d:DesignWidth="900" d:DesignHeight="600"
             FontFamily="Microsoft YaHei"
             Background="White">

    <UserControl.Resources>
        <!-- 左侧 ListBox 项样式 -->
        <Style x:Key="OperatorListBoxItemStyle" TargetType="ListBoxItem">
            <Setter Property="Height" Value="44"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#2C3E50"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#E9ECEF"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}"
                                x:Name="ItemBorder">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" 
                                           Text="👤" 
                                           FontSize="18" 
                                           VerticalAlignment="Center"
                                           Margin="0,0,10,0"/>
                                <TextBlock Grid.Column="1"
                                           Text="{Binding Name}"
                                           VerticalAlignment="Center"
                                           FontSize="16"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#3498DB"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#EBF5FB"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 通用按钮样式 -->
        <Style x:Key="ActionButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="130"/>
            <Setter Property="Height" Value="44"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="6"
                                BorderThickness="0">
                            <ContentPresenter HorizontalAlignment="Center"
                                            VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Opacity" Value="0.85"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.5"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- 返回按钮样式 -->
        <Style x:Key="BackButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="130"/>
            <Setter Property="Height" Value="44"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="#95A5A6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="6"
                                BorderThickness="0">
                            <ContentPresenter HorizontalAlignment="Center"
                                            VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Opacity" Value="0.85"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <!-- ===== 主布局 ===== -->
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <!-- 顶部标题栏 -->
            <RowDefinition Height="Auto"/>
            <!-- 主体内容区 -->
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ================================================================ -->
        <!-- 顶部标题栏 -->
        <!-- ================================================================ -->
        <Border Grid.Row="0" 
                Background="#2C3E50" 
                CornerRadius="8"
                Padding="16,12"
                Margin="0,0,0,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="👥 " FontSize="24" Foreground="White" VerticalAlignment="Center"/>
                    <TextBlock Text="作业员设定" 
                               FontSize="24" 
                               FontWeight="Bold"
                               Foreground="White"
                               VerticalAlignment="Center"/>
                    <TextBlock Text=" — 管理人员名单" 
                               FontSize="14"
                               Foreground="#BDC3C7"
                               VerticalAlignment="Center"
                               Margin="12,0,0,0"/>
                </StackPanel>

                <!-- 返回主菜单按钮 -->
                <Button Grid.Column="1" 
                        Style="{StaticResource BackButtonStyle}"
                        Content="↩ 返回主菜单"
                        Command="{Binding GoBackCommand}"
                        VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <!-- ================================================================ -->
        <!-- 主体：左右分栏 -->
        <!-- ================================================================ -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <!-- 左侧：人员列表区 -->
                <ColumnDefinition Width="340"/>
                <!-- 分割线 -->
                <ColumnDefinition Width="2"/>
                <!-- 右侧：操作区 -->
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ===== 左侧：人员列表 ===== -->
            <Border Grid.Column="0" 
                    Background="#F8F9FA" 
                    CornerRadius="8"
                    BorderBrush="#DEE2E6"
                    BorderThickness="1"
                    Padding="16">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- 子标题 -->
                    <Border Grid.Row="0" 
                            Background="#34495E" 
                            CornerRadius="6"
                            Padding="12,10"
                            Margin="0,0,0,12">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <TextBlock Text="📋 " FontSize="16" Foreground="White"/>
                            <TextBlock Text="已登记作业员" 
                                       FontSize="16" 
                                       FontWeight="Bold"
                                       Foreground="White"/>
                        </StackPanel>
                    </Border>

                    <!-- 列表 -->
                    <ListBox Grid.Row="1"
                             ItemsSource="{Binding Operators}"
                             SelectedItem="{Binding SelectedOperator}"
                             ItemContainerStyle="{StaticResource OperatorListBoxItemStyle}"
                             BorderBrush="#CED4DA"
                             BorderThickness="1"
                             Background="White"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                             x:Name="OperatorListBox">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Name}" 
                                           FontSize="16"
                                           VerticalAlignment="Center"/>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <!-- 底部统计 -->
                    <Border Grid.Row="2" 
                            Background="#E9ECEF" 
                            CornerRadius="4"
                            Padding="10,6"
                            Margin="0,10,0,0">
                        <TextBlock HorizontalAlignment="Center" 
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   Foreground="#2C3E50"
                                   Text="{Binding TotalCountText}"/>
                    </Border>
                </Grid>
            </Border>

            <!-- 分割线 -->
            <Border Grid.Column="1" 
                    Background="#DEE2E6" 
                    Margin="10,20"/>

            <!-- ================================================================ -->
            <!-- 右侧：操作区 -->
            <!-- ================================================================ -->
            <Border Grid.Column="2" 
                    Background="White" 
                    CornerRadius="8"
                    BorderBrush="#DEE2E6"
                    BorderThickness="1"
                    Padding="28">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- 区域标题 -->
                    <TextBlock Grid.Row="0" 
                               Text="✏️ 编辑作业员" 
                               FontSize="22" 
                               FontWeight="Bold"
                               Foreground="#2C3E50"
                               Margin="0,0,0,24"/>

                    <!-- 输入标签 -->
                    <TextBlock Grid.Row="1" 
                               Text="作业员名字" 
                               FontSize="15" 
                               FontWeight="SemiBold"
                               Foreground="#495057"
                               Margin="0,0,0,8"/>

                    <!-- 输入框 -->
                    <TextBox Grid.Row="2"
                             Text="{Binding InputName, UpdateSourceTrigger=PropertyChanged}"
                             FontSize="22"
                             FontWeight="Bold"
                             Height="52"
                             Padding="14,10"
                             BorderBrush="#3498DB"
                             BorderThickness="2"
                             Background="#EBF5FB"
                             VerticalContentAlignment="Center"
                             x:Name="InputNameTextBox"
                             ToolTip="输入新作业员名字，或选择左侧列表中的名字进行修改">
                        <TextBox.Style>
                            <Style TargetType="TextBox">
                                <Setter Property="Background" Value="#EBF5FB"/>
                                <Style.Triggers>
                                    <Trigger Property="Text" Value="">
                                        <Setter Property="Background">
                                            <Setter.Value>
                                                <VisualBrush AlignmentX="Left" AlignmentY="Center" Stretch="None">
                                                    <VisualBrush.Visual>
                                                        <TextBlock Text="输入作业员名字..."
                                                                   FontSize="18"
                                                                   Foreground="#ADB5BD"
                                                                   FontStyle="Italic"/>
                                                    </VisualBrush.Visual>
                                                </VisualBrush>
                                            </Setter.Value>
                                        </Setter>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </TextBox.Style>
                    </TextBox>

                    <!-- 动态提示区 -->
                    <Border Grid.Row="3" 
                            CornerRadius="6"
                            Padding="14,10"
                            Margin="0,16,0,20">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HintColor}" Value="#27AE60">
                                        <Setter Property="Background" Value="#D5F5E3"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding HintColor}" Value="#F39C12">
                                        <Setter Property="Background" Value="#FEF9E7"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding HintColor}" Value="#E67E22">
                                        <Setter Property="Background" Value="#FDF2E9"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding HintColor}" Value="#6C757D">
                                        <Setter Property="Background" Value="#F8F9FA"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" 
                                       Text="💡 " 
                                       FontSize="18"
                                       VerticalAlignment="Center"
                                       Margin="0,0,8,0"/>
                            <TextBlock Grid.Column="1"
                                       Text="{Binding HintText}"
                                       FontSize="15"
                                       Foreground="{Binding HintColor}"
                                       VerticalAlignment="Center"
                                       TextWrapping="Wrap"/>
                        </Grid>
                    </Border>

                    <Border Grid.Row="4" 
                            CornerRadius="6"
                            Padding="14,10"
                            Margin="0,0,0,16">          
                        <Border.Style>
                            <Style TargetType="Border">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasCurrentOperator}" Value="True">
                                        <Setter Property="Background" Value="#D5F5E3"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding HasCurrentOperator}" Value="False">
                                        <Setter Property="Background" Value="#FEF9E7"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <!-- 状态文字 -->
                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <TextBlock FontSize="14" FontWeight="Bold" Foreground="#2C3E50">
                                <Run Text="🎯 "/>
                                <Run Text="{Binding CurrentOperatorDisplay}"/>
                                </TextBlock>
                                <TextBlock FontSize="11" Foreground="#6C757D" 
                                           Text="此作业员将在点击「运行界面」时自动使用"
                                           Margin="0,4,0,0"/>
                            </StackPanel>

                            <!-- 设为当前按钮 -->
                            <Button Grid.Column="1"
                                    Content="⭐ 设为当前"
                                    Command="{Binding SetAsCurrentOperatorCommand}"
                                    Width="110"
                                    Height="38"
                                    FontSize="14"
                                    FontWeight="Bold"
                                    Foreground="White"
                                    Background="#F39C12"
                                    Cursor="Hand"
                                    VerticalAlignment="Center"
                                    Margin="12,0,0,0">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}"
                                                CornerRadius="6"
                                                BorderThickness="0">
                                            <ContentPresenter HorizontalAlignment="Center"
                                                                 VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Button.Template>
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="Background" Value="#F39C12"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding CanDelete}" Value="False">
                                                <Setter Property="Background" Value="#B2BEC3"/>
                                                <Setter Property="IsEnabled" Value="False"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                        </Grid>
                    </Border>

                    <!-- 弹性空间 -->
                    <Grid Grid.Row="4"/>

                    <!-- 按钮组 -->
                    <UniformGrid Grid.Row="5" 
                                 Rows="1" 
                                 Columns="3"
                                 HorizontalAlignment="Center">

                        <!-- 新增/更新按钮 -->
                        <Button Style="{StaticResource ActionButtonStyle}"
                                Background="#3498DB"
                                Content="✔ 新  增"
                                Command="{Binding AddOrUpdateCommand}"
                                Margin="8,0"/>

                        <!-- 删除按钮 -->
                        <Button Content="🗑 删  除"
                                Command="{Binding DeleteCommand}"
                                Margin="8,0">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource ActionButtonStyle}">
                                    <Setter Property="Background" Value="#E74C3C"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding CanDelete}" Value="False">
                                            <Setter Property="Background" Value="#B2BEC3"/>
                                            <Setter Property="IsEnabled" Value="False"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>

                        <!-- 清空输入按钮 -->
                        <Button Style="{StaticResource ActionButtonStyle}"
                                Background="#95A5A6"
                                Content="✖ 清  空"
                                Command="{Binding ClearInputCommand}"
                                Margin="8,0"/>
                    </UniformGrid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>