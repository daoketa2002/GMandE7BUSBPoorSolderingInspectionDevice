<!--
  ============================================================
  文件: Views/TestPageView.xaml
  修改: 
    1. 移除"开始测试"按钮（改为PLC信号触发）
    2. 输入控件绑定 IsEnabled/IsReadOnly（由UiState控制）
    3. 右上角状态显示区绑定物检传感器状态
    4. 方案名称从只读TextBox改为可编辑ComboBox（与机种联动）
    5. 底部操作区重构：终了独立突出 + 调试工具可折叠面板
    6. 日志区与按钮区滚动分离，日志区固定不随按钮区滚动
  ============================================================
-->
<UserControl x:Class="GMandE7BUSBPoorSolderingInspectionDevice.Views.TestPageView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:GMandE7BUSBPoorSolderingInspectionDevice.Views"
             xmlns:converters="clr-namespace:GMandE7BUSBPoorSolderingInspectionDevice.Common.Converters"
             xmlns:vm="clr-namespace:GMandE7BUSBPoorSolderingInspectionDevice.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:TestPageViewModel}"
             d:DesignWidth="1200" d:DesignHeight="800"
             FontFamily="Microsoft YaHei">

    <UserControl.Resources>
        <converters:JudgmentToBackgroundConverter x:Key="JudgmentToBackgroundConverter"/>
        <converters:JudgmentToForegroundConverter x:Key="JudgmentToForegroundConverter"/>
        <converters:DeviceConnectionStatusToColorConverter x:Key="DeviceConnectionStatusToColorConverter"/>
        <converters:DeviceConnectionStatusToShadowColorConverter x:Key="DeviceConnectionStatusToShadowColorConverter"/>
        <converters:BoolInverterConverter x:Key="BoolInverterConverter"/>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>

        <Style x:Key="TopPanelBorder" TargetType="Border">
            <Setter Property="Background" Value="#F8F9FA"/>
            <Setter Property="BorderBrush" Value="#DEE2E6"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="12"/>
            <Setter Property="Margin" Value="4"/>
        </Style>

        <Style x:Key="StatNumberStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="36"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="StatLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Foreground" Value="#6C757D"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
        </Style>

        <!-- ============================================================
     设备状态指示灯按钮样式（优化版）
     改动说明：
       1. 按钮尺寸 110×40 → 120×48，容纳更大字号
       2. 主标签 14px → 16px，状态标签 11px → 12px
       3. 移除状态标签 Opacity="0.9"，消除光晕效应
       4. 增加底部阴影 BorderThickness="0,0,0,4"，参照"终了"按钮立体感
       5. 圆角 6px → 8px，保持层次感
       6. 内部布局由 StackPanel 改为 Grid + RowDefinitions，行距更舒展
     ============================================================ -->
        <Style x:Key="DeviceStatusButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="120"/>
            <Setter Property="Height" Value="48"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="8,2"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <!-- 外层：表面背景色 -->
                        <Border x:Name="buttonSurface"
                        Background="{TemplateBinding Background}"
                        CornerRadius="8">
                            <!-- 内层：底部厚阴影（立体感来源） -->
                            <Border x:Name="buttonBase"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="0,0,0,4"
                            CornerRadius="8">
                                <ContentPresenter x:Name="buttonContent"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          Margin="{TemplateBinding Padding}"/>
                            </Border>
                        </Border>
                        <ControlTemplate.Triggers>
                            <!-- 悬停：轻微变亮 -->
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="buttonSurface" Property="Opacity" Value="0.88"/>
                            </Trigger>
                            <!-- 按下：底部阴影变薄 + 内容下移 → 按下反馈 -->
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="buttonBase" Property="BorderThickness" Value="0,0,0,2"/>
                                <Setter TargetName="buttonContent" Property="Margin" Value="0,2,0,0"/>
                            </Trigger>
                            <!-- 禁用：半透明 -->
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="buttonSurface" Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>


        <Style x:Key="ClearCountButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="50"/>
            <Setter Property="Height" Value="50"/>
            <Setter Property="Background" Value="#E74C3C"/>
            <Setter Property="BorderBrush" Value="#C0392B"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="clearButtonSurface"
                                    Background="{TemplateBinding Background}"
                                    CornerRadius="25">
                            <Border x:Name="clearButtonBase"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="0,0,0,4"
                                    CornerRadius="25">
                                <ContentPresenter x:Name="clearButtonContent"
                                                  HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"/>
                            </Border>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="clearButtonSurface" Property="Opacity" Value="0.88"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="clearButtonBase" Property="BorderThickness" Value="0,0,0,2"/>
                                <Setter TargetName="clearButtonContent" Property="Margin" Value="0,2,0,0"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="clearButtonSurface" Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TestDataGridStyle" TargetType="DataGrid">
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="RowHeight" Value="40"/>
            <Setter Property="ColumnHeaderHeight" Value="40"/>
            <Setter Property="GridLinesVisibility" Value="All"/>
            <Setter Property="HorizontalGridLinesBrush" Value="#DEE2E6"/>
            <Setter Property="VerticalGridLinesBrush" Value="#DEE2E6"/>
            <Setter Property="BorderBrush" Value="#CED4DA"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="CanUserDeleteRows" Value="False"/>
            <Setter Property="CanUserReorderColumns" Value="False"/>
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="AutoGenerateColumns" Value="False"/>
            <Setter Property="SelectionMode" Value="Single"/>
            <Setter Property="RowBackground" Value="White"/>
            <Setter Property="AlternatingRowBackground" Value="#F8F9FA"/>
        </Style>

        <!-- 调试工具按钮统一样式，减少重复模板 -->
        <Style x:Key="DebugButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="38"/>
            <Setter Property="MinWidth" Value="110"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="6" BorderThickness="0">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 真实模式的终了和复位共用主操作样式，避免与调试按钮混用。 -->
        <Style x:Key="MainOperationButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="72"/>
            <Setter Property="FontSize" Value="22"/>
            <Setter Property="FontWeight" Value="ExtraBold"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="buttonSurface"
                                Background="{TemplateBinding Background}"
                                CornerRadius="12">
                            <Border x:Name="buttonBase"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="0,0,0,4"
                                    CornerRadius="12">
                                <ContentPresenter x:Name="buttonContent"
                                                  HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                  VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                            </Border>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="buttonSurface" Property="Opacity" Value="0.88"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="buttonBase" Property="BorderThickness" Value="0,0,0,2"/>
                                <Setter TargetName="buttonContent" Property="Margin" Value="0,2,0,0"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="buttonSurface" Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Background="#FFFFFF">
        <Grid.RowDefinitions>
            <RowDefinition Height="160"/>
            <RowDefinition Height="70"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="180"/>
        </Grid.RowDefinitions>

        <!-- 1. 顶部状态与统计区 -->
        <Grid Grid.Row="0" Margin="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="360"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="260"/>
            </Grid.ColumnDefinitions>

            <!-- 1-1 左侧：生产统计面板 -->
            <Border Grid.Column="0" Style="{StaticResource TopPanelBorder}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <DockPanel Grid.Row="0" Margin="0,0,0,8">
                        <TextBlock Text="方案名称：" FontSize="14" Foreground="#495057" VerticalAlignment="Center"/>
                        <ComboBox IsEditable="True"
                                  Text="{Binding SchemeName, UpdateSourceTrigger=PropertyChanged}"
                                  ItemsSource="{Binding PlanNameOptions}"
                                  SelectedItem="{Binding SelectedPlanName}"
                                  FontSize="14" FontWeight="Bold"
                                  Height="32" VerticalContentAlignment="Center"
                                  x:Name="SchemeNameComboBox">
                            <ComboBox.Style>
                                <Style TargetType="ComboBox">
                                    <Setter Property="BorderBrush" Value="#CED4DA"/>
                                    <Setter Property="BorderThickness" Value="1"/>
                                    <Setter Property="ToolTip" Value=""/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsSchemeNameInvalid}" Value="True">
                                            <Setter Property="BorderBrush" Value="#E74C3C"/>
                                            <Setter Property="BorderThickness" Value="2"/>
                                            <Setter Property="ToolTip" Value="当前方案无效，请重新选择"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ComboBox.Style>
                        </ComboBox>
                    </DockPanel>

                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="60"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding TotalCount}" Style="{StaticResource StatNumberStyle}" Foreground="#3498DB"/>
                            <TextBlock Text="检查数量" Style="{StaticResource StatLabelStyle}"/>
                        </StackPanel>

                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="{Binding PassCount}" Style="{StaticResource StatNumberStyle}" Foreground="#27AE60"/>
                            <TextBlock Text="良品数量" Style="{StaticResource StatLabelStyle}"/>
                        </StackPanel>

                        <StackPanel Grid.Column="2" VerticalAlignment="Center">
                            <TextBlock Text="{Binding FailCount}" Style="{StaticResource StatNumberStyle}" Foreground="#E74C3C"/>
                            <TextBlock Text="不良数量" Style="{StaticResource StatLabelStyle}"/>
                        </StackPanel>

                        <Button Grid.Column="3" Content="清零"
                                Command="{Binding ClearCountersCommand}"
                                Style="{StaticResource ClearCountButtonStyle}"
                                VerticalAlignment="Center"
                                ToolTip="清零计数器" Cursor="Hand"/>
                    </Grid>
                </Grid>
            </Border>

            <!-- 1-2 中间：设备连接状态看板 -->
            <Border Grid.Column="1" Style="{StaticResource TopPanelBorder}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Background="#2C3E50" CornerRadius="4" Padding="10,6" Margin="0,0,0,8">
                        <TextBlock Text="{Binding CurrentTime}" FontSize="22" FontWeight="Bold"
                                   Foreground="#ECF0F1" HorizontalAlignment="Center" FontFamily="Consolas"/>
                    </Border>

                    <UniformGrid Grid.Row="1" Rows="1" Columns="4" HorizontalAlignment="Center">
                        <!-- ═══════════ PLC 按钮 ═══════════ -->
                        <Button Style="{StaticResource DeviceStatusButtonStyle}"
                                Command="{Binding ReconnectPlcCommand}" Margin="6">
                            <Button.Background>
                                <SolidColorBrush Color="{Binding PlcConnectionStatus, Converter={StaticResource DeviceConnectionStatusToColorConverter}}"/>
                            </Button.Background>
                            <Button.BorderBrush>
                                <SolidColorBrush Color="{Binding PlcConnectionStatus, Converter={StaticResource DeviceConnectionStatusToShadowColorConverter}}"/>
                            </Button.BorderBrush>
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="26"/>
                                    <RowDefinition Height="18"/>
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Text="PLC"
                                           FontSize="16" FontWeight="Bold"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Bottom"/>
                                <TextBlock Grid.Row="1" Text="{Binding PlcStatusText}"
                                           FontSize="12"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Top"/>
                            </Grid>
                        </Button>

                        <!-- ═══════════ 扫描仪按钮 ═══════════ -->
                        <Button Style="{StaticResource DeviceStatusButtonStyle}"
                                Command="{Binding ReconnectScannerCommand}" Margin="6">
                            <Button.Background>
                                <SolidColorBrush Color="{Binding ScannerConnectionStatus, Converter={StaticResource DeviceConnectionStatusToColorConverter}}"/>
                            </Button.Background>
                            <Button.BorderBrush>
                                <SolidColorBrush Color="{Binding ScannerConnectionStatus, Converter={StaticResource DeviceConnectionStatusToShadowColorConverter}}"/>
                            </Button.BorderBrush>
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="26"/>
                                    <RowDefinition Height="18"/>
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Text="扫描仪"
                                           FontSize="16" FontWeight="Bold"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Bottom"/>
                                <TextBlock Grid.Row="1" Text="{Binding ScannerStatusText}"
                                           FontSize="12"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Top"/>
                            </Grid>
                        </Button>

                        <!-- ═══════════ 万用表按钮 ═══════════ -->
                        <Button Style="{StaticResource DeviceStatusButtonStyle}"
                                Command="{Binding ReconnectDmmCommand}" Margin="6">
                            <Button.Background>
                                <SolidColorBrush Color="{Binding DmmConnectionStatus, Converter={StaticResource DeviceConnectionStatusToColorConverter}}"/>
                            </Button.Background>
                            <Button.BorderBrush>
                                <SolidColorBrush Color="{Binding DmmConnectionStatus, Converter={StaticResource DeviceConnectionStatusToShadowColorConverter}}"/>
                            </Button.BorderBrush>
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="26"/>
                                    <RowDefinition Height="18"/>
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Text="万用表"
                                           FontSize="16" FontWeight="Bold"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Bottom"/>
                                <TextBlock Grid.Row="1" Text="{Binding DmmStatusText}"
                                           FontSize="12"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Top"/>
                            </Grid>
                        </Button>

                        <!-- ═══════════ PC 按钮 ═══════════ -->
                        <Button Style="{StaticResource DeviceStatusButtonStyle}"
                                Margin="6" IsHitTestVisible="False">
                            <Button.Background>
                                <SolidColorBrush Color="#27AE60"/>
                            </Button.Background>
                            <Button.BorderBrush>
                                <!-- PC 按钮颜色固定为绿色，阴影色手动计算：#27AE60 × 0.6 = #186A40 -->
                                <SolidColorBrush Color="#186A40"/>
                            </Button.BorderBrush>
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="26"/>
                                    <RowDefinition Height="18"/>
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Text="PC"
                                           FontSize="16" FontWeight="Bold"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Bottom"/>
                                <TextBlock Grid.Row="1" Text="就绪"
                                           FontSize="12"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Top"/>
                            </Grid>
                        </Button>
                    </UniformGrid>
                </Grid>
            </Border>

            <!-- 1-3 右侧：测试状态显示 -->
            <Border Grid.Column="2" Style="{StaticResource TopPanelBorder}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="测试状态" FontSize="16" FontWeight="Bold"
                               Foreground="#495057" HorizontalAlignment="Center" Margin="0,0,0,8"/>

                    <Border Grid.Row="1" CornerRadius="8" Margin="4">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="#95A5A6"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding UiState}" Value="CanStart">
                                        <Setter Property="Background" Value="#27AE60"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding UiState}" Value="Testing">
                                        <Setter Property="Background" Value="#F39C12"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding UiState}" Value="CompletedPass">
                                        <Setter Property="Background" Value="#27AE60"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding UiState}" Value="CompletedFail">
                                        <Setter Property="Background" Value="#E74C3C"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding UiState}" Value="Paused">
                                        <Setter Property="Background" Value="#F1C40F"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding UiState}" Value="AwaitingReset">
                                        <Setter Property="Background" Value="#F1C40F"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding UiState}" Value="EmergencyStop">
                                        <Setter Property="Background" Value="#E74C3C"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding UiState}" Value="SingleItemNgStopped">
                                        <Setter Property="Background" Value="#E74C3C"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding UiState}" Value="Resetting">
                                        <Setter Property="Background" Value="#8E44AD"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding UiState}" Value="ResetFailed">
                                        <Setter Property="Background" Value="#D35400"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding UiState}" Value="Error">
                                        <Setter Property="Background" Value="#C0392B"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding UiState}" Value="Ready">
                                        <Setter Property="Background" Value="#95A5A6"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock FontSize="28" FontWeight="Bold" Foreground="White"
                                   HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Text" Value="待机中"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding UiState}" Value="CanStart">
                                            <Setter Property="Text" Value="可启动"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding UiState}" Value="Testing">
                                            <Setter Property="Text" Value="测试中"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding UiState}" Value="CompletedPass">
                                            <Setter Property="Text" Value="OK"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding UiState}" Value="CompletedFail">
                                            <Setter Property="Text" Value="NG"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding UiState}" Value="Paused">
                                            <Setter Property="Text" Value="已停止"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding UiState}" Value="AwaitingReset">
                                            <Setter Property="Text" Value="请复位"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding UiState}" Value="EmergencyStop">
                                            <Setter Property="Text" Value="急停中"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding UiState}" Value="SingleItemNgStopped">
                                            <Setter Property="Text" Value="NG"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding UiState}" Value="Resetting">
                                            <Setter Property="Text" Value="复位中"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding UiState}" Value="ResetFailed">
                                            <Setter Property="Text" Value="复位失败"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding UiState}" Value="Error">
                                            <Setter Property="Text" Value="异常"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding UiState}" Value="Ready">
                                            <Setter Property="Text" Value="待机中"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <!-- 2. 中部信息录入区 -->
        <Border Grid.Row="1" Background="#F8F9FA" BorderBrush="#DEE2E6" BorderThickness="1"
                CornerRadius="6" Margin="8,4" Padding="12,8"
                IsEnabled="{Binding IsInputEnabled}">
            <UniformGrid Rows="1" Columns="3" HorizontalAlignment="Stretch">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center">
                    <TextBlock Text="机种名称：" FontSize="16" FontWeight="Bold"
                               Foreground="#495057" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBox Text="{Binding ModelName, UpdateSourceTrigger=PropertyChanged}"
                             FontSize="16" Width="200" Height="36" MaxLength="50"
                             VerticalContentAlignment="Center" BorderBrush="#CED4DA"
                             x:Name="ModelNameTextBox" KeyDown="InputTextBox_KeyDown"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center">
                    <TextBlock Text="序列号：" FontSize="16" FontWeight="Bold"
                               Foreground="#495057" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBox Text="{Binding SerialNumber, UpdateSourceTrigger=PropertyChanged}"
                             FontSize="16" Width="220" Height="36" MaxLength="50"
                             VerticalContentAlignment="Center" BorderBrush="#CED4DA" BorderThickness="1"
                             x:Name="SerialNumberTextBox" KeyDown="InputTextBox_KeyDown"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center">
                    <TextBlock Text="作业员：" FontSize="16" FontWeight="Bold"
                               Foreground="#495057" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <Border Width="160" Height="36" Background="#E8F8F5"
                            BorderBrush="#27AE60" BorderThickness="2" CornerRadius="4"
                            Margin="0,0,8,0">
                        <TextBlock Text="{Binding OperatorName}"
                                   FontSize="16"
                                   FontWeight="Bold"
                                   Foreground="#1E8449"
                                   VerticalAlignment="Center"
                                   HorizontalAlignment="Center"
                                   TextTrimming="CharacterEllipsis"/>
                    </Border>
                    <Button Content="重新选择"
                            Width="86"
                            Height="36"
                            Command="{Binding ChangeOperatorCommand}"/>
                </StackPanel>
            </UniformGrid>
        </Border>

        <!-- 3. 下部测试列表区（自定义合并表头 + DataGrid） -->
        <Grid Grid.Row="2" Margin="8,4">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" x:Name="CustomHeaderGrid">
                <Grid.RowDefinitions>
                    <RowDefinition Height="40"/>
                    <RowDefinition Height="40"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Background="#2C3E50" BorderBrush="#1A252F" BorderThickness="0,0,0,1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition x:Name="HeaderCol0" Width="80"/>
                            <ColumnDefinition x:Name="HeaderCol1" Width="200"/>
                            <ColumnDefinition x:Name="HeaderCol2" Width="420"/>
                            <ColumnDefinition x:Name="HeaderCol5" Width="280"/>
                            <ColumnDefinition x:Name="HeaderCol6" Width="180"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" BorderBrush="#1A252F" BorderThickness="0,0,1,0">
                            <TextBlock Text="序号" Foreground="White" FontSize="16" FontWeight="Bold"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <Border Grid.Column="1" BorderBrush="#1A252F" BorderThickness="0,0,1,0">
                            <TextBlock Text="项目名称" Foreground="White" FontSize="16" FontWeight="Bold"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <Border Grid.Column="2" BorderBrush="#1A252F" BorderThickness="0,0,1,0">
                            <TextBlock Text="检查条件" Foreground="White" FontSize="16" FontWeight="Bold"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <Border Grid.Column="3" BorderBrush="#1A252F" BorderThickness="0,0,1,0">
                            <TextBlock Text="检查结果" Foreground="White" FontSize="16" FontWeight="Bold"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <Border Grid.Column="4">
                            <TextBlock Text="判  定" Foreground="White" FontSize="16" FontWeight="Bold"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </Grid>
                </Border>

                <Border Grid.Row="1" Background="#34495E" BorderBrush="#1A252F" BorderThickness="0,0,0,2">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="{Binding ElementName=HeaderCol0, Path=Width}"/>
                            <ColumnDefinition Width="{Binding ElementName=HeaderCol1, Path=Width}"/>
                            <ColumnDefinition x:Name="HeaderSubCol2" Width="120"/>
                            <ColumnDefinition x:Name="HeaderSubCol3" Width="150"/>
                            <ColumnDefinition x:Name="HeaderSubCol4" Width="150"/>
                            <ColumnDefinition Width="{Binding ElementName=HeaderCol5, Path=Width}"/>
                            <ColumnDefinition Width="{Binding ElementName=HeaderCol6, Path=Width}"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0"/>
                        <Border Grid.Column="1"/>
                        <Border Grid.Column="2" BorderBrush="#1A252F" BorderThickness="0,0,1,0">
                            <TextBlock Text="检查方式" Foreground="#BDC3C7" FontSize="14" FontWeight="SemiBold"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <Border Grid.Column="3" BorderBrush="#1A252F" BorderThickness="0,0,1,0">
                            <TextBlock Text="下限 (Ω)" Foreground="#BDC3C7" FontSize="14" FontWeight="SemiBold"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <Border Grid.Column="4" BorderBrush="#1A252F" BorderThickness="0,0,1,0">
                            <TextBlock Text="上限 (Ω)" Foreground="#BDC3C7" FontSize="14" FontWeight="SemiBold"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <Border Grid.Column="5"/>
                        <Border Grid.Column="6"/>
                    </Grid>
                </Border>
            </Grid>

            <DataGrid Grid.Row="1" ItemsSource="{Binding TestItems}"
                      Style="{StaticResource TestDataGridStyle}"
                      HeadersVisibility="None" x:Name="TestDataGrid">
                <DataGrid.Columns>
                    <DataGridTextColumn Binding="{Binding Index}" Width="80">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="HorizontalAlignment" Value="Center"/>
                                <Setter Property="VerticalAlignment" Value="Center"/>
                                <Setter Property="FontSize" Value="18"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <DataGridTextColumn Binding="{Binding ItemName}" Width="200">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="HorizontalAlignment" Value="Center"/>
                                <Setter Property="VerticalAlignment" Value="Center"/>
                                <Setter Property="FontSize" Value="18"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <DataGridTextColumn Binding="{Binding CheckMode}" Width="120">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="HorizontalAlignment" Value="Center"/>
                                <Setter Property="VerticalAlignment" Value="Center"/>
                                <Setter Property="FontSize" Value="16"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <DataGridTextColumn Binding="{Binding LowerLimitText}" Width="150">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="HorizontalAlignment" Value="Center"/>
                                <Setter Property="VerticalAlignment" Value="Center"/>
                                <Setter Property="FontSize" Value="16"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <DataGridTextColumn Binding="{Binding UpperLimitText}" Width="150">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="HorizontalAlignment" Value="Center"/>
                                <Setter Property="VerticalAlignment" Value="Center"/>
                                <Setter Property="FontSize" Value="16"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <DataGridTextColumn Binding="{Binding CheckResult}" Width="280">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="HorizontalAlignment" Value="Center"/>
                                <Setter Property="VerticalAlignment" Value="Center"/>
                                <Setter Property="FontSize" Value="18"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                                <Setter Property="TextWrapping" Value="NoWrap"/>
                                <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                                <Setter Property="ToolTip" Value="{Binding CheckResult}"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <DataGridTemplateColumn Width="180">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border CornerRadius="4" Padding="12,4" Margin="4">
                                    <Border.Background>
                                        <SolidColorBrush Color="{Binding Judgment, Converter={StaticResource JudgmentToBackgroundConverter}}"/>
                                    </Border.Background>
                                    <TextBlock Text="{Binding Judgment}" FontSize="22" FontWeight="ExtraBold"
                                               HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <TextBlock.Foreground>
                                            <SolidColorBrush Color="{Binding Judgment, Converter={StaticResource JudgmentToForegroundConverter}}"/>
                                        </TextBlock.Foreground>
                                    </TextBlock>
                                </Border>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Grid>

        <!-- ================================================================ -->
        <!-- 4. 底部日志与操作区（日志区与按钮区滚动分离） -->
        <!--
            设计说明：
            1. 左右分离：日志区固定不动（ListBox自带内部滚动），右侧按钮区独立滚动
            2. 只有右侧按钮区包裹 ScrollViewer，调试面板展开时只有右侧可滚动
            3. 日志区始终完整可见，不受调试面板展开影响
        -->
        <!-- ================================================================ -->
        <Grid Grid.Row="3" Margin="8,4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="320"/>
            </Grid.ColumnDefinitions>

            <!-- ═══════════ 左侧：日志显示区（固定不动，ListBox自带内部滚动） ═══════════ -->
            <Border Grid.Column="0"
                    Background="#1A1A2E" CornerRadius="6"
                    BorderBrush="#16213E" BorderThickness="1" Padding="8">
                <ListBox ItemsSource="{Binding LogMessages}"
                         Background="Transparent" Foreground="#00FF88"
                         FontFamily="Consolas" FontSize="13" BorderThickness="0"
                         x:Name="LogListBox"
                         ScrollViewer.HorizontalScrollBarVisibility="Auto"
                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                         VirtualizingPanel.ScrollUnit="Pixel">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Foreground" Value="#00FF88"/>
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="Padding" Value="2,1"/>
                            <Setter Property="FontSize" Value="13"/>
                        </Style>
                    </ListBox.ItemContainerStyle>
                </ListBox>
            </Border>

            <!-- ═══════════ 右侧：操作按钮区（独立滚动） ═══════════ -->
            <!--
                只有右侧包裹 ScrollViewer，调试面板展开时右侧出现滚动条，
                左侧日志区完全不受影响。
            -->
            <ScrollViewer Grid.Column="1" Margin="12,0,0,0"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <Grid>
                    <Grid.RowDefinitions>
                        <!-- 主操作区：终了按钮 -->
                        <RowDefinition Height="Auto"/>
                        <!-- 真实模式操作区：复位 -->
                        <RowDefinition Height="Auto"/>
                        <!-- 调试工具区（可折叠，仅 Fake 模式） -->
                        <RowDefinition Height="Auto"/>
                        <!-- 弹性空白，将按钮推到顶部 -->
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- ═══════ 主操作区：终了按钮 ═══════ -->
                    <Button Grid.Row="0" Content="终了"
                            Command="{Binding FinishAndReturnCommand}"
                            Style="{StaticResource MainOperationButtonStyle}"
                            Background="#E74C3C"
                            BorderBrush="#C0392B"/>

                    <!-- ═══════ 调试工具区：可折叠面板（Fake 或半实物模式） ═══════ -->
                    <Expander Grid.Row="2" IsExpanded="False" Margin="0,0,0,0"
                              Visibility="{Binding IsDebugControlPanelVisible, Converter={StaticResource BoolToVisibilityConverter}}">
                        <Expander.Header>
                            <TextBlock Text="调试面板" FontSize="13" FontWeight="SemiBold"
                                       Foreground="#7F8C8D" Margin="4,2"/>
                        </Expander.Header>
                        <Border Background="#F5F6FA" CornerRadius="8" Padding="6"
                                BorderBrush="#E0E0E0" BorderThickness="1">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <!-- 第1行：启动(DT120) | 停止(DT122) -->
                                <UniformGrid Grid.Row="0" Rows="1" Columns="2" Margin="0,0,0,4">
                                    <Button Content="启动(DT120)"
                                            Command="{Binding TriggerDebugStartCommand}"
                                            Style="{StaticResource DebugButtonStyle}"
                                            Background="#2E86DE"
                                            ToolTip="写入 DT120=1，走 PLC 轮询启动复核链路"/>
                                    <Button Content="停止(DT122)"
                                            Command="{Binding TriggerDebugStopCommand}"
                                            Style="{StaticResource DebugButtonStyle}"
                                            Background="#F39C12"
                                            ToolTip="写入 DT122=1，触发停止收口流程"/>
                                </UniformGrid>

                                <!-- 第2行：复位(DT121) | 急停(DT123) -->
                                <UniformGrid Grid.Row="1" Rows="1" Columns="2" Margin="0,0,0,4">
                                    <Button Content="复位(DT121)"
                                            Command="{Binding TriggerDebugResetCommand}"
                                            Style="{StaticResource DebugButtonStyle}"
                                            Background="#8E44AD"
                                            ToolTip="写入 DT121=1，触发复位收口流程"/>
                                    <Button Content="急停(DT123)"
                                            Command="{Binding TriggerDebugEmergencyStopCommand}"
                                            Style="{StaticResource DebugButtonStyle}"
                                            Background="#E74C3C"
                                            ToolTip="写入 DT123=1，触发急停收口流程"/>
                                </UniformGrid>

                            </Grid>
                        </Border>
                    </Expander>

                    <!-- ═══════ 真实模式操作区：复位 ═══════ -->
                    <Button Grid.Row="1" Content="复位"
                            Command="{Binding TriggerPlcResetCommand}"
                            Style="{StaticResource MainOperationButtonStyle}"
                            Background="#8E44AD"
                            BorderBrush="#6C3483"
                            ToolTip="执行设备复位"
                            Visibility="{Binding IsRealModeResetVisible, Converter={StaticResource BoolToVisibilityConverter}}"/>
                </Grid>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>
