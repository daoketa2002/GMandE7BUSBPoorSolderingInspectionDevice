<UserControl x:Class="WPFStandardFramework.Views.BaseLayoutView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:WPFStandardFramework.Views"
             mc:Ignorable="d" 
             d:DesignWidth="1200" d:DesignHeight="800">
    <Grid>
        <!-- 定义行：顶部固定高度，内容区自适应 -->
        <Grid.RowDefinitions>
            <RowDefinition Height="50"/>
            <!-- Header 固定高度 -->
            <RowDefinition Height="*"/>
            <!-- 内容区占剩余空间 -->
        </Grid.RowDefinitions>

        <!-- 顶部区域 -->
        <Border Background="LightGray" Grid.Row="0">
            <TextBlock Text="应用标题" VerticalAlignment="Center" Margin="10"/>
        </Border>

        <!-- 主内容区（业务页面容器） -->
        <ContentControl x:Name="InnerContentRegion" 
                        Grid.Row="1"
                        MinWidth="800" MinHeight="500" />
    </Grid>

</UserControl>
