<Window x:Class="GMandE7BUSBPoorSolderingInspectionDevice.Views.ExitConfirmDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:GMandE7BUSBPoorSolderingInspectionDevice.Views"
        mc:Ignorable="d"
        Title="ExitConfirmDialog" Height="450" Width="800"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" 
                   Text="确定要退出系统吗？" 
                   FontSize="16"
                   FontWeight="Bold"
                   HorizontalAlignment="Center"
                   Margin="0,0,0,20"/>

        <StackPanel Grid.Row="2" 
                    Orientation="Horizontal" 
                    HorizontalAlignment="Center">

            <Button Content="确认退出"
                    Command="{Binding ConfirmExitCommand}"
                    Background="#E74C3C"
                    Foreground="White"
                    Width="120"
                    Height="35"
                    Margin="10"/>

            <Button Content="取消"
                    Command="{Binding CancelCommand}"
                    Background="#95A5A6"
                    Foreground="White"
                    Width="120"
                    Height="35"
                    Margin="10"/>
        </StackPanel>
    </Grid>
</Window>
