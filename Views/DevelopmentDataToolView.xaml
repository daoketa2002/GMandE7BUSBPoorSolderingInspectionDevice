<UserControl x:Class="GMandE7BUSBPoorSolderingInspectionDevice.Views.DevelopmentDataToolView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="720"
             d:DesignWidth="1000">
    <Grid Background="#F4F6F8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#34495E" Padding="18" Margin="16" CornerRadius="8">
            <DockPanel>
                <Button DockPanel.Dock="Right"
                        Width="110"
                        Height="36"
                        Content="返回"
                        Command="{Binding NavigateBackCommand}"
                        Background="#7F8C8D"
                        Foreground="White"
                        BorderThickness="0"/>
                <TextBlock Text="开发测试数据工具"
                           FontSize="24"
                           FontWeight="Bold"
                           Foreground="White"
                           VerticalAlignment="Center"/>
            </DockPanel>
        </Border>

        <ScrollViewer Grid.Row="1" Margin="16,0,16,0" VerticalScrollBarVisibility="Auto">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="360"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Background="White" BorderBrush="#DDE3EA" BorderThickness="1" Padding="16" CornerRadius="8">
                    <StackPanel>
                        <TextBlock Text="参数" FontSize="18" FontWeight="Bold" Margin="0,0,0,12"/>

                        <TextBlock Text="月份"/>
                        <TextBox Text="{Binding CurrentMonth, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,10"/>

                        <TextBlock Text="机种"/>
                        <TextBox Text="{Binding MachineType, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,10"/>

                        <TextBlock Text="方案数量"/>
                        <TextBox Text="{Binding PlanCount, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,10"/>

                        <TextBlock Text="记录数量"/>
                        <TextBox Text="{Binding RecordCount, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,10"/>

                        <TextBlock Text="开始月份"/>
                        <TextBox Text="{Binding StartMonth, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,10"/>

                        <TextBlock Text="月份数量"/>
                        <TextBox Text="{Binding MonthCount, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,10"/>

                        <TextBlock Text="每月记录数量"/>
                        <TextBox Text="{Binding RecordsPerMonth, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>

                <StackPanel Grid.Column="1" Margin="16,0,0,0">
                    <Border Background="White" BorderBrush="#DDE3EA" BorderThickness="1" Padding="16" CornerRadius="8">
                        <StackPanel>
                            <TextBlock Text="当前 TestLog 根目录" FontSize="16" FontWeight="Bold"/>
                            <TextBlock Text="{Binding TestLogRootPath}" TextWrapping="Wrap" Margin="0,8,0,0"/>
                        </StackPanel>
                    </Border>

                    <UniformGrid Columns="2" Margin="0,16,0,0">
                        <Button Content="生成100条正常链路数据"
                                Height="48"
                                Margin="0,0,8,8"
                                Command="{Binding GenerateNormalDataCommand}"/>
                        <Button Content="生成单月性能数据"
                                Height="48"
                                Margin="8,0,0,8"
                                Command="{Binding GenerateBulkMonthDataCommand}"/>
                        <Button Content="生成跨月份历史数据"
                                Height="48"
                                Margin="0,8,8,8"
                                Command="{Binding GenerateHistoryDataCommand}"/>
                        <Button Content="重建当前月份索引"
                                Height="48"
                                Margin="8,8,0,8"
                                Command="{Binding RebuildCurrentMonthIndexCommand}"/>
                        <Button Content="清理全部 ZZTEST 测试数据"
                                Height="48"
                                Margin="0,8,8,0"
                                Background="#E74C3C"
                                Foreground="White"
                                Command="{Binding ClearDevDataCommand}"/>
                    </UniformGrid>

                    <Border Background="White" BorderBrush="#DDE3EA" BorderThickness="1" Padding="16" CornerRadius="8" Margin="0,16,0,0">
                        <StackPanel>
                            <TextBlock Text="当前状态" FontSize="16" FontWeight="Bold"/>
                            <TextBlock Text="{Binding StatusText}" Margin="0,8,0,8"/>
                            <ProgressBar Minimum="0"
                                         Maximum="{Binding ProgressMaximum}"
                                         Value="{Binding Progress}"
                                         Height="18"/>
                            <TextBlock Text="{Binding LastResult}" TextWrapping="Wrap" Margin="0,12,0,0"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </ScrollViewer>

        <TextBlock Grid.Row="2"
                   Text="ZZTEST- 测试数据仅用于 Debug 阶段，清理仅操作 ZZTEST- 前缀测试文件。"
                   Margin="16"
                   Foreground="#7F8C8D"/>
    </Grid>
</UserControl>
