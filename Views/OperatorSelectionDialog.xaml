<Window x:Class="GMandE7BUSBPoorSolderingInspectionDevice.Views.OperatorSelectionDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="作业员选择"
        Width="620"
        Height="560"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#F4F6F8"
        FontFamily="Microsoft YaHei UI">
    <Window.Resources>
        <Style x:Key="RoundedActionButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="40"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.88"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.76"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.45"/>
                                <Setter Property="Cursor" Value="Arrow"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="OperatorListBoxItemStyle" TargetType="ListBoxItem">
            <Setter Property="Height" Value="48"/>
            <Setter Property="Margin" Value="2"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="Foreground" Value="#2C3E50"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="ItemBorder"
                                Background="White"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#EAF2F8"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#3498DB"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="78"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Background="#2C3E50"
                CornerRadius="8"
                Padding="20,12"
                Margin="0,0,0,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="👤 作业员选择"
                               FontSize="24"
                               FontWeight="Bold"
                               Foreground="White"/>
                    <TextBlock Text="请选择本次检测的作业员"
                               FontSize="13"
                               Foreground="#D5DBDB"
                               Margin="0,4,0,0"/>
                </StackPanel>

                <Border Grid.Column="1"
                        Background="#34495E"
                        CornerRadius="14"
                        Padding="14,6"
                        VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="当前选择："
                                   FontSize="13"
                                   Foreground="#D5DBDB"
                                   VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding SelectedOperator.Name, TargetNullValue=未选择}"
                                   FontSize="14"
                                   FontWeight="Bold"
                                   Foreground="White"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <TextBlock Grid.Row="1"
                   Text="已登记作业员"
                   FontSize="16"
                   FontWeight="Bold"
                   Foreground="#2C3E50"
                   Margin="2,0,0,8"/>

        <Border Grid.Row="2"
                Background="White"
                BorderBrush="#DEE2E6"
                BorderThickness="1"
                CornerRadius="8"
                Padding="8">
            <ListBox ItemsSource="{Binding Operators}"
                     SelectedItem="{Binding SelectedOperator}"
                     MouseDoubleClick="OperatorListBox_MouseDoubleClick"
                     BorderThickness="0"
                     Background="Transparent"
                     ItemContainerStyle="{StaticResource OperatorListBoxItemStyle}"
                     ScrollViewer.VerticalScrollBarVisibility="Auto">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="👤"
                                       FontSize="16"
                                       Margin="0,0,10,0"
                                       VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding Name}"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>

        <TextBlock Grid.Row="3"
                   Text="新增作业员（可手动输入，也可扫描作业员工号）"
                   FontSize="16"
                   FontWeight="Bold"
                   Foreground="#2C3E50"
                   Margin="2,18,0,8"/>

        <Grid Grid.Row="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="90"/>
            </Grid.ColumnDefinitions>

            <TextBox Text="{Binding InputName, UpdateSourceTrigger=PropertyChanged}"
                     Height="40"
                     FontSize="15"
                     Foreground="#2C3E50"
                     BorderBrush="#DEE2E6"
                     BorderThickness="1"
                     VerticalContentAlignment="Center"
                     Padding="12,0"
                     Margin="0,0,10,0"/>
            <Button Grid.Column="1"
                    Content="新增"
                    Width="90"
                    Background="#3498DB"
                    Style="{StaticResource RoundedActionButtonStyle}"
                    Command="{Binding AddOperatorCommand}"/>
        </Grid>

        <Grid Grid.Row="5" Margin="0,10,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Text="{Binding HintText}"
                       FontSize="13"
                       Foreground="#6C757D"
                       TextWrapping="Wrap"
                       Margin="2,0,0,12"/>

            <StackPanel Grid.Row="1"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right">
                <Button Content="删除"
                        Width="90"
                        Background="#E74C3C"
                        Style="{StaticResource RoundedActionButtonStyle}"
                        Command="{Binding DeleteOperatorCommand}"/>
                <Button Content="取消"
                        Width="90"
                        Background="#95A5A6"
                        Style="{StaticResource RoundedActionButtonStyle}"
                        Command="{Binding CancelCommand}"
                        Margin="10,0,0,0"/>
                <Button Content="确认选择"
                        Width="120"
                        Background="#27AE60"
                        Style="{StaticResource RoundedActionButtonStyle}"
                        Command="{Binding ConfirmSelectionCommand}"
                        Margin="10,0,0,0"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
