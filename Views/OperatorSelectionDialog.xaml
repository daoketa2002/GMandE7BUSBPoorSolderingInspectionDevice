<Window x:Class="GMandE7BUSBPoorSolderingInspectionDevice.Views.OperatorSelectionDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:GMandE7BUSBPoorSolderingInspectionDevice.Views"
        xmlns:converters="clr-namespace:GMandE7BUSBPoorSolderingInspectionDevice.Common.Converters"
        mc:Ignorable="d"
        Title="选择作业员"
        Height="500" 
        Width="700"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="White"
        FontFamily="Microsoft YaHei">

    <Window.Resources>
        <!-- 左侧 ListBox 项样式 -->
        <Style x:Key="OperatorListBoxItemStyle" TargetType="ListBoxItem">
            <Setter Property="Height" Value="42"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#2C3E50"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#E9ECEF"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <!-- 人员图标 -->
                                <TextBlock Grid.Column="0" 
                                           Text="👤" 
                                           FontSize="18" 
                                           VerticalAlignment="Center"
                                           Margin="0,0,10,0"/>
                                <!-- 人员名字 -->
                                <TextBlock Grid.Column="1"
                                           Text="{Binding Name}"
                                           VerticalAlignment="Center"
                                           FontSize="16"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="#3498DB"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#EBF5FB"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 按钮样式 -->
        <Style x:Key="ActionButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="120"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="6"
                                BorderThickness="0">
                            <ContentPresenter HorizontalAlignment="Center"
                                            VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- ===== 主布局：左右分栏 ===== -->
    <Grid Margin="16">
        <Grid.ColumnDefinitions>
            <!-- 左侧：人员列表区 -->
            <ColumnDefinition Width="320"/>
            <!-- 分割线 -->
            <ColumnDefinition Width="2"/>
            <!-- 右侧：信息交互区 -->
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ================================================================ -->
        <!-- 左侧：人员列表区 -->
        <!-- ================================================================ -->
        <Border Grid.Column="0" 
                Background="#F8F9FA" 
                CornerRadius="8"
                BorderBrush="#DEE2E6"
                BorderThickness="1"
                Padding="12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- 标题 -->
                <Border Grid.Row="0" 
                        Background="#2C3E50" 
                        CornerRadius="6"
                        Padding="12,8"
                        Margin="0,0,0,10">
                    <TextBlock Text="👥 作业员名字列表" 
                               FontSize="16" 
                               FontWeight="Bold"
                               Foreground="White"
                               HorizontalAlignment="Center"/>
                </Border>

                <!-- 列表 -->
                <ListBox Grid.Row="1"
                         ItemsSource="{Binding Operators}"
                         SelectedItem="{Binding SelectedOperator}"
                         ItemContainerStyle="{StaticResource OperatorListBoxItemStyle}"
                         BorderBrush="#CED4DA"
                         BorderThickness="1"
                         Background="White"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                         x:Name="OperatorListBox">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Name}" 
                                       FontSize="16"
                                       VerticalAlignment="Center"/>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <!-- 底部统计 -->
                <Border Grid.Row="2" 
                        Background="#E9ECEF" 
                        CornerRadius="4"
                        Padding="8,4"
                        Margin="0,8,0,0">
                    <TextBlock HorizontalAlignment="Center" 
                               FontSize="12"
                               Foreground="#6C757D">
                        <Run Text="共 "/>
                        <Run Text="{Binding Operators.Count, Mode=OneWay}" FontWeight="Bold"/>
                        <Run Text=" 名作业员"/>
                    </TextBlock>
                </Border>
            </Grid>
        </Border>

        <!-- 分割线 -->
        <Border Grid.Column="1" 
                Background="#DEE2E6" 
                Margin="8,0"/>

        <!-- ================================================================ -->
        <!-- 右侧：信息交互与操作区 -->
        <!-- ================================================================ -->
        <Border Grid.Column="2" 
                Background="White" 
                CornerRadius="8"
                BorderBrush="#DEE2E6"
                BorderThickness="1"
                Padding="20">
            <Grid>
                <Grid.RowDefinitions>
                    <!-- 目标字段 -->
                    <RowDefinition Height="Auto"/>
                    <!-- 动态提示区 -->
                    <RowDefinition Height="Auto"/>
                    <!-- 弹性空间 -->
                    <RowDefinition Height="*"/>
                    <!-- 功能按钮组 -->
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- ===== 顶部：目标字段 ===== -->
                <StackPanel Grid.Row="0" Margin="0,0,0,12">
                    <TextBlock Text="作业员名字" 
                               FontSize="14" 
                               FontWeight="SemiBold"
                               Foreground="#495057"
                               Margin="0,0,0,6"/>
                    <TextBox Text="{Binding InputName, UpdateSourceTrigger=PropertyChanged}"
                             FontSize="20"
                             FontWeight="Bold"
                             Height="46"
                             Padding="12,8"
                             BorderBrush="#3498DB"
                             BorderThickness="2"
                             Background="#EBF5FB"
                             VerticalContentAlignment="Center"
                             x:Name="InputNameTextBox"
                             ToolTip="请选择左侧列表中的作业员，或直接输入新名字">
                        <TextBox.Resources>
                            <!-- 水印效果（当 Text 为空时显示） -->
                            <VisualBrush x:Key="Watermark" 
                                         AlignmentX="Left" 
                                         AlignmentY="Center" 
                                         Stretch="None">
                                <VisualBrush.Visual>
                                    <TextBlock Text="选择或输入作业员名字..."
                                               FontSize="16"
                                               Foreground="#ADB5BD"
                                               FontStyle="Italic"/>
                                </VisualBrush.Visual>
                            </VisualBrush>
                        </TextBox.Resources>
                        <TextBox.Style>
                            <Style TargetType="TextBox">
                                <Setter Property="Background" Value="#EBF5FB"/>
                                <Style.Triggers>
                                    <Trigger Property="Text" Value="">
                                        <Setter Property="Background">
                                            <Setter.Value>
                                                <VisualBrush AlignmentX="Left" AlignmentY="Center" Stretch="None">
                                                    <VisualBrush.Visual>
                                                        <TextBlock Text="选择或输入作业员名字..."
                                                                   FontSize="16"
                                                                   Foreground="#ADB5BD"
                                                                   FontStyle="Italic"/>
                                                    </VisualBrush.Visual>
                                                </VisualBrush>
                                            </Setter.Value>
                                        </Setter>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </TextBox.Style>
                    </TextBox>
                </StackPanel>

                <!-- ===== 中部：动态提示区 ===== -->
                <Border Grid.Row="1" 
                        CornerRadius="4"
                        Padding="10,8"
                        Margin="0,0,0,16">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HintColor}" Value="#27AE60">
                                    <Setter Property="Background" Value="#D5F5E3"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding HintColor}" Value="#F39C12">
                                    <Setter Property="Background" Value="#FEF9E7"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding HintColor}" Value="#E67E22">
                                    <Setter Property="Background" Value="#FDF2E9"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding HintColor}" Value="#6C757D">
                                    <Setter Property="Background" Value="#F8F9FA"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" 
                                   Text="💡 " 
                                   FontSize="16"
                                   VerticalAlignment="Center"
                                   Margin="0,0,6,0"/>
                        <TextBlock Grid.Column="1"
                                   Text="{Binding HintText}"
                                   FontSize="14"
                                   Foreground="{Binding HintColor}"
                                   VerticalAlignment="Center"
                                   TextWrapping="Wrap"/>
                    </Grid>
                </Border>

                <!-- ===== 底部：功能按钮组 ===== -->
                <UniformGrid Grid.Row="3" 
                             Rows="1" 
                             Columns="3"
                             HorizontalAlignment="Center">

                    <!-- 确认按钮（无触发器，用属性 Style 即可） -->
                    <Button Style="{StaticResource ActionButtonStyle}"
                            Background="#3498DB"
                            Content="✔ 确  认"
                            Command="{Binding ConfirmCommand}"
                            Margin="6,0"/>

                    <!-- 删除按钮（需要 DataTrigger 动态切换，只使用子元素 Style） -->
                    <Button Content="🗑 删  除"
                            Command="{Binding DeleteCommand}"
                            Margin="6,0">               
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource ActionButtonStyle}">
                                <Setter Property="Background" Value="#E74C3C"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding CanDelete}" Value="False">
                                        <Setter Property="Background" Value="#B2BEC3"/>
                                        <Setter Property="IsEnabled" Value="False"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>

                    <!-- 退出按钮（无触发器，用属性 Style 即可） -->
                    <Button Style="{StaticResource ActionButtonStyle}"
                            Background="#95A5A6"
                            Content="✖ 退  出"
                            Command="{Binding CancelCommand}"
                            Margin="6,0"/>

                </UniformGrid>
            </Grid>
        </Border>
    </Grid>
</Window>