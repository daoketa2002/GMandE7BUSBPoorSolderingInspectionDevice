<!--
  ============================================================
  文件: Views/LogDataView.xaml
  修改:
    1. 布局重构：日期行上移，操作按钮统一放第三行
    2. 新增「🧹清空条件」按钮
    3. DatePicker 增加清除"小x"样式
    4. 修复分页按钮悬停/点击变白问题
    5. 导出按钮与检索/重置同行，节省垂直空间
    ⭐ 6. 新增扫描枪状态栏（扫码自动填充机种名称和序列号）
  ============================================================
-->
<UserControl x:Class="GMandE7BUSBPoorSolderingInspectionDevice.Views.LogDataView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:GMandE7BUSBPoorSolderingInspectionDevice.Views"
             xmlns:vm="clr-namespace:GMandE7BUSBPoorSolderingInspectionDevice.ViewModels"
             xmlns:converters="clr-namespace:GMandE7BUSBPoorSolderingInspectionDevice.Common.Converters"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:LogDataViewModel}"
             d:DesignWidth="1200" d:DesignHeight="700"
             FontFamily="Microsoft YaHei"
             Background="White">

    <UserControl.Resources>
        <!-- 综合判定 → 背景色转换器（OK=绿, NG=红 等） -->
        <converters:JudgmentToBackgroundConverter x:Key="JudgmentToBackgroundConverter"/>
        <!-- 综合判定 → 前景色转换器 -->
        <converters:JudgmentToForegroundConverter x:Key="JudgmentToForegroundConverter"/>
        <!-- bool → Visibility 转换器 -->
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        <!-- bool → Visibility（通用版） -->
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
        <!-- bool → Opacity 转换器（分页按钮禁用态） -->
        <converters:BoolToOpacityConverter x:Key="BoolToOpacityConverter"
                                           EnabledOpacity="1.0"
                                           DisabledOpacity="0.5"/>

        <!-- ⭐ AlternationIndex + 1 转换器 -->
        <converters:IntPlusOneConverter x:Key="AlternationIndexConverter"/>
    </UserControl.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- 0: 标题栏 -->
            <RowDefinition Height="Auto"/>
            <!-- 1: 检索条件区 -->
            <!-- ⭐ 新增行：扫描枪状态栏 -->
            <RowDefinition Height="Auto"/>
            <!-- 2: 扫描枪状态栏 -->
            <RowDefinition Height="Auto"/>
            <!-- 3: 加载提示 -->
            <RowDefinition Height="*"/>
            <!-- 4: 数据表格 -->
            <RowDefinition Height="Auto"/>
            <!-- 5: 分页控件 -->
            <RowDefinition Height="Auto"/>
            <!-- 6: 底部状态栏 -->
        </Grid.RowDefinitions>

        <!-- ===== ① 标题栏 ===== -->
        <Border Grid.Row="0"
                Background="#2C3E50"
                CornerRadius="8"
                Padding="16,12"
                Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="📊 " FontSize="24" Foreground="White" VerticalAlignment="Center"/>
                    <TextBlock Text="日志数据"
                               FontSize="24" FontWeight="Bold"
                               Foreground="White" VerticalAlignment="Center"/>
                    <TextBlock Text=" — 检测结果浏览与检索"
                               FontSize="14" Foreground="#BDC3C7"
                               VerticalAlignment="Center" Margin="12,0,0,0"/>
                </StackPanel>
                <Button Grid.Column="1"
                        Content="↩ 返回主菜单"
                        Command="{Binding GoBackCommand}"
                        Width="130" Height="40"
                        FontSize="14" FontWeight="Bold"
                        Foreground="White" Background="#95A5A6"
                        Cursor="Hand" BorderThickness="0">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}"
                                    CornerRadius="6"
                                    BorderThickness="0">
                                <ContentPresenter HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </Grid>
        </Border>

        <!-- ===== ② 检索条件区 ===== -->
        <Border Grid.Row="1"
                Background="#F8F9FA"
                CornerRadius="8"
                BorderBrush="#DEE2E6"
                BorderThickness="1"
                Padding="16,12"
                Margin="0,0,0,12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <!-- 第一行：机种名称 / 序列号 / 方案名称 / 判定结果 -->
                    <RowDefinition Height="Auto"/>
                    <!-- 第二行：开始日期 / 结束日期 -->
                    <RowDefinition Height="Auto"/>
                    <!-- 第三行：操作按钮（检索/重置/清空/导出） -->
                </Grid.RowDefinitions>

                <!-- 第一行：机种名称 / 序列号 / 方案名称 / 判定结果 -->
                <Grid Grid.Row="0" Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="1.2*"/>
                        <ColumnDefinition Width="20"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="1.5*"/>
                        <ColumnDefinition Width="20"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="1.2*"/>
                        <ColumnDefinition Width="20"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="1*"/>
                    </Grid.ColumnDefinitions>

                    <!-- 机种名称 -->
                    <TextBlock Grid.Column="0" Text="机种名称：" VerticalAlignment="Center"
                               FontSize="14" FontWeight="SemiBold" Foreground="#495057"/>
                    <ComboBox Grid.Column="1"
                              IsEditable="True"
                              Text="{Binding SelectedMachineType, UpdateSourceTrigger=PropertyChanged}"
                              ItemsSource="{Binding MachineTypes}"
                              Height="36" FontSize="14"
                              VerticalContentAlignment="Center"
                              ToolTip="可选择预设值或手动输入（扫码自动填充）"/>

                    <!-- 序列号 -->
                    <TextBlock Grid.Column="3" Text="序列号：" VerticalAlignment="Center"
                               FontSize="14" FontWeight="SemiBold" Foreground="#495057"/>
                    <TextBox Grid.Column="4"
                             Text="{Binding SearchSerialNumber, UpdateSourceTrigger=PropertyChanged}"
                             Height="36" FontSize="14"
                             VerticalContentAlignment="Center"
                             ToolTip="输入序列号进行检索（支持模糊匹配，扫码自动填充）"/>

                    <!-- 方案名称 -->
                    <TextBlock Grid.Column="6" Text="方案名称：" VerticalAlignment="Center"
                               FontSize="14" FontWeight="SemiBold" Foreground="#495057"/>
                    <ComboBox Grid.Column="7"
                              IsEditable="True"
                              Text="{Binding SelectedPlanName, UpdateSourceTrigger=PropertyChanged}"
                              ItemsSource="{Binding PlanNames}"
                              Height="36" FontSize="14"
                              VerticalContentAlignment="Center"
                              ToolTip="选择方案名称（全部方案=不筛选）"/>

                    <!-- 判定结果 -->
                    <TextBlock Grid.Column="9" Text="判定结果：" VerticalAlignment="Center"
                               FontSize="14" FontWeight="SemiBold" Foreground="#495057"/>
                    <ComboBox Grid.Column="10"
                              SelectedItem="{Binding FilterFinalResult}"
                              ItemsSource="{Binding FinalResultOptions}"
                              Height="36" FontSize="14"
                              VerticalContentAlignment="Center"/>
                </Grid>

                <!-- 第二行：开始日期 / 结束日期 -->
                <Grid Grid.Row="1" Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="1.5*"/>
                        <ColumnDefinition Width="20"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="1.5*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- 开始日期 -->
                    <TextBlock Grid.Column="0" Text="开始日期：" VerticalAlignment="Center"
                               FontSize="14" FontWeight="SemiBold" Foreground="#495057"/>
                    <DatePicker Grid.Column="1"
                                SelectedDate="{Binding StartDate}"
                                Height="36" FontSize="14"
                                VerticalContentAlignment="Center"
                                x:Name="StartDatePicker"
                                ToolTip="选择查询起始日期（含当天）"/>

                    <!-- 结束日期 -->
                    <TextBlock Grid.Column="3" Text="结束日期：" VerticalAlignment="Center"
                               FontSize="14" FontWeight="SemiBold" Foreground="#495057"/>
                    <DatePicker Grid.Column="4"
                                SelectedDate="{Binding EndDate}"
                                Height="36" FontSize="14"
                                VerticalContentAlignment="Center"
                                x:Name="EndDatePicker"
                                ToolTip="选择查询截止日期（含当天）"/>
                </Grid>

                <!-- 第三行：操作按钮（检索/重置/清空条件/导出CSV） -->
                <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Left">
                    <!-- 🔍 检索 -->
                    <Button Content="🔍 检索"
                            Command="{Binding SearchCommand}"
                            Width="90" Height="38"
                            FontSize="14" FontWeight="Bold"
                            Foreground="White" Background="#3498DB"
                            Cursor="Hand" BorderThickness="0"
                            Margin="0,0,10,0">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="border"
                                        Background="{TemplateBinding Background}"
                                        CornerRadius="6"
                                        BorderThickness="0">
                                    <ContentPresenter HorizontalAlignment="Center"
                                                      VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="border"
                                                Property="Background" Value="#2980B9"/>
                                    </Trigger>
                                    <Trigger Property="IsPressed" Value="True">
                                        <Setter TargetName="border"
                                                Property="Background" Value="#2471A3"/>
                                    </Trigger>
                                    <Trigger Property="IsEnabled" Value="False">
                                        <Setter TargetName="border"
                                                Property="Opacity" Value="0.6"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                    <!-- ↺ 重置 -->
                    <Button Content="↺ 重置"
                            Command="{Binding ResetCommand}"
                            Width="90" Height="38"
                            FontSize="14" FontWeight="Bold"
                            Foreground="White" Background="#E67E22"
                            Cursor="Hand" BorderThickness="0"
                            Margin="0,0,10,0">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="border"
                                        Background="{TemplateBinding Background}"
                                        CornerRadius="6"
                                        BorderThickness="0">
                                    <ContentPresenter HorizontalAlignment="Center"
                                                      VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="border"
                                                Property="Background" Value="#D35400"/>
                                    </Trigger>
                                    <Trigger Property="IsPressed" Value="True">
                                        <Setter TargetName="border"
                                                Property="Background" Value="#BA4A00"/>
                                    </Trigger>
                                    <Trigger Property="IsEnabled" Value="False">
                                        <Setter TargetName="border"
                                                Property="Opacity" Value="0.6"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                    <!-- 🧹 清空条件 -->
                    <Button Content="🧹 清空条件"
                            Command="{Binding ClearConditionsCommand}"
                            Width="110" Height="38"
                            FontSize="14" FontWeight="Bold"
                            Foreground="White" Background="#95A5A6"
                            Cursor="Hand" BorderThickness="0"
                            Margin="0,0,10,0"
                            ToolTip="清空所有检索条件输入框（不刷新表格）">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="border"
                                        Background="{TemplateBinding Background}"
                                        CornerRadius="6"
                                        BorderThickness="0">
                                    <ContentPresenter HorizontalAlignment="Center"
                                                      VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="border"
                                                Property="Background" Value="#7F8C8D"/>
                                    </Trigger>
                                    <Trigger Property="IsPressed" Value="True">
                                        <Setter TargetName="border"
                                                Property="Background" Value="#707B7C"/>
                                    </Trigger>
                                    <Trigger Property="IsEnabled" Value="False">
                                        <Setter TargetName="border"
                                                Property="Opacity" Value="0.6"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                    <!-- 📥 导出CSV -->
                    <Button Content="📥 导出CSV"
                            Command="{Binding ExportToCsvCommand}"
                            Width="120" Height="38"
                            FontSize="14" FontWeight="Bold"
                            Foreground="White" Background="#27AE60"
                            Cursor="Hand" BorderThickness="0"
                            ToolTip="导出当前筛选条件下的全部数据为CSV文件">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="border"
                                        Background="{TemplateBinding Background}"
                                        CornerRadius="6"
                                        BorderThickness="0">
                                    <ContentPresenter HorizontalAlignment="Center"
                                                      VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="border"
                                                Property="Background" Value="#219A52"/>
                                    </Trigger>
                                    <Trigger Property="IsPressed" Value="True">
                                        <Setter TargetName="border"
                                                Property="Background" Value="#1E8449"/>
                                    </Trigger>
                                    <Trigger Property="IsEnabled" Value="False">
                                        <Setter TargetName="border"
                                                Property="Opacity" Value="0.6"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ⭐ ===== 扫描枪状态栏 ===== -->
        <Border Grid.Row="2" CornerRadius="6" BorderThickness="1" Padding="10,6" Margin="0,0,0,8">
            <Border.Style>
                <Style TargetType="Border">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsScannerConnected}" Value="True">
                            <Setter Property="Background" Value="#FFF3CD"/>
                            <Setter Property="BorderBrush" Value="#FFEAA7"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding IsScannerConnected}" Value="False">
                            <Setter Property="Background" Value="#E9ECEF"/>
                            <Setter Property="BorderBrush" Value="#CED4DA"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- 连接状态图标+文本 -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock FontSize="16" VerticalAlignment="Center">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsScannerConnected}" Value="True">
                                        <Setter Property="Text" Value="📷"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsScannerConnected}" Value="False">
                                        <Setter Property="Text" Value="📴"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <TextBlock VerticalAlignment="Center" FontSize="14" FontWeight="Bold" Margin="4,0,0,0">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsScannerConnected}" Value="True">
                                        <Setter Property="Text" Value="扫描枪已连接 — 扫码自动填充机种名称和序列号"/>
                                        <Setter Property="Foreground" Value="#856404"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsScannerConnected}" Value="False">
                                        <Setter Property="Text" Value="扫描枪未连接"/>
                                        <Setter Property="Foreground" Value="#6C757D"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>

                <!-- 最近扫描条码 -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="20,0,0,0"
                    Visibility="{Binding IsScannerConnected, Converter={StaticResource BoolToVisibilityConverter}}">
                    <TextBlock Text="最近扫描: " FontSize="13" Foreground="#856404" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding ScannedBarcode}" FontSize="13" FontWeight="Bold"
                       Foreground="#856404" VerticalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ===== ③ 加载提示 ===== -->
        <Border Grid.Row="3"
                Background="#EBF5FB"
                CornerRadius="4"
                Padding="10,6"
                Margin="0,0,0,8"
                Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}">
            <TextBlock Text="⏳ 正在加载日志数据，请稍候..."
                       FontSize="14" Foreground="#2980B9"
                       HorizontalAlignment="Center"/>
        </Border>

        <!-- ===== ④ 数据表格 ===== -->
        <DataGrid Grid.Row="4"
                  ItemsSource="{Binding LogDataList}"
                  AlternationCount="100000"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  CanUserAddRows="False"
                  CanUserDeleteRows="False"
                  CanUserReorderColumns="False"
                  CanUserSortColumns="True"
                  SelectionMode="Extended"
                  SelectionUnit="FullRow"
                  GridLinesVisibility="Horizontal"
                  HorizontalGridLinesBrush="#E9ECEF"
                  RowHeaderWidth="0"
                  RowHeight="36"
                  ColumnHeaderHeight="40"
                  FontSize="13"
                  VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Auto"
                  Background="White"
                  BorderBrush="#DEE2E6"
                  BorderThickness="1"
                  x:Name="LogDataGrid">
            <DataGrid.Resources>
                <Style TargetType="DataGridColumnHeader">
                    <Setter Property="Background" Value="#34495E"/>
                    <Setter Property="Foreground" Value="White"/>
                    <Setter Property="FontWeight" Value="Bold"/>
                    <Setter Property="FontSize" Value="13"/>
                    <Setter Property="HorizontalContentAlignment" Value="Center"/>
                    <Setter Property="Padding" Value="8,0"/>
                    <Setter Property="BorderBrush" Value="#2C3E50"/>
                    <Setter Property="BorderThickness" Value="0,0,0,2"/>
                </Style>
                <Style TargetType="DataGridRow">
                    <Setter Property="Background" Value="White"/>
                    <Style.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="#EBF5FB"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="Background" Value="#D4E6F1"/>
                        </Trigger>
                    </Style.Triggers>
                </Style>
                <Style TargetType="DataGridCell">
                    <Setter Property="VerticalContentAlignment" Value="Center"/>
                    <Setter Property="HorizontalContentAlignment" Value="Center"/>
                    <Setter Property="Padding" Value="6,0"/>
                    <Setter Property="BorderBrush" Value="#E9ECEF"/>
                    <Setter Property="BorderThickness" Value="0,0,0,0"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="DataGridCell">
                                <Border Background="{TemplateBinding Background}"
                                        BorderBrush="{TemplateBinding BorderBrush}"
                                        BorderThickness="{TemplateBinding BorderThickness}"
                                        Padding="{TemplateBinding Padding}">
                                    <ContentPresenter VerticalAlignment="Center"
                                                      HorizontalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </DataGrid.Resources>

            <!-- ===== 固定列定义 ===== -->
            <DataGrid.Columns>
                <!-- 序号列（使用 AlternationIndex，从1开始） -->
                <DataGridTextColumn Header="序号"
                    Binding="{Binding RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=DataGridRow}, Path=(ItemsControl.AlternationIndex), Converter={StaticResource AlternationIndexConverter}}"
                    Width="60"/>
                <!-- 机种名称 -->
                <DataGridTextColumn Header="机种名称"
                        Binding="{Binding Series}"
                        Width="100"/>
                <!-- 序列号 -->
                <DataGridTextColumn Header="序列号"
                        Binding="{Binding SerialNumber}"
                        Width="140"/>
                <!-- 方案名称 -->
                <DataGridTextColumn Header="方案名称"
                        Binding="{Binding PlanName}"
                        Width="120"/>
                <!-- 操作员 -->
                <DataGridTextColumn Header="操作员"
                        Binding="{Binding Operator}"
                        Width="90"/>
                <!-- 综合判定 — 带颜色标签 -->
                <DataGridTemplateColumn Header="综合判定" Width="90">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Border CornerRadius="4"
                        Padding="8,3"
                        HorizontalAlignment="Center"
                        Background="{Binding FinalResult, Converter={StaticResource JudgmentToBackgroundConverter}}">
                                <TextBlock Text="{Binding FinalResult}"
                               FontWeight="Bold"
                               FontSize="13"
                               Foreground="{Binding FinalResult, Converter={StaticResource JudgmentToForegroundConverter}}"
                               HorizontalAlignment="Center"/>
                            </Border>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <!-- 注：动态列由 LogDataView.xaml.cs 在运行时生成 -->
            </DataGrid.Columns>
        </DataGrid>

        <!-- ===== ⑤ 分页控件 ===== -->
        <Border Grid.Row="5"
                Background="#F8F9FA"
                CornerRadius="4"
                BorderBrush="#DEE2E6"
                BorderThickness="1"
                Padding="10,8"
                Margin="0,8,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- 左侧：每页显示条数 -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="每页显示：" FontSize="13" Foreground="#495057" VerticalAlignment="Center"/>
                    <ComboBox ItemsSource="{Binding PageSizeOptions}"
                              SelectedItem="{Binding PageSize}"
                              Width="70" Height="30"
                              FontSize="13"
                              VerticalContentAlignment="Center"
                              Margin="6,0,0,0"/>
                </StackPanel>

                <!-- 中间：页码信息 -->
                <TextBlock Grid.Column="1"
                           Text="{Binding PageInfoText}"
                           FontSize="14" FontWeight="SemiBold"
                           Foreground="#2C3E50"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"/>

                <!-- 右侧：翻页按钮 -->
                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <!-- ◀ 上一页 -->
                    <Button Content="◀ 上一页"
                            Command="{Binding PreviousPageCommand}"
                            Width="90" Height="32"
                            FontSize="13" FontWeight="Bold"
                            Foreground="White"
                            Cursor="Hand" BorderThickness="0"
                            Margin="0,0,8,0">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="border"
                                        CornerRadius="4"
                                        BorderThickness="0"
                                        Background="#3498DB"
                                        Opacity="{Binding IsEnabled, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource BoolToOpacityConverter}}">
                                    <ContentPresenter HorizontalAlignment="Center"
                                                      VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsEnabled" Value="True">
                                        <Setter TargetName="border" Property="Background" Value="#3498DB"/>
                                    </Trigger>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="border" Property="Background" Value="#2980B9"/>
                                    </Trigger>
                                    <Trigger Property="IsPressed" Value="True">
                                        <Setter TargetName="border" Property="Background" Value="#2471A3"/>
                                    </Trigger>
                                    <Trigger Property="IsEnabled" Value="False">
                                        <Setter TargetName="border" Property="Background" Value="#95A5A6"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                    <!-- 下一页 ▶ -->
                    <Button Content="下一页 ▶"
                            Command="{Binding NextPageCommand}"
                            Width="90" Height="32"
                            FontSize="13" FontWeight="Bold"
                            Foreground="White"
                            Cursor="Hand" BorderThickness="0">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="border"
                                        CornerRadius="4"
                                        BorderThickness="0"
                                        Background="#3498DB"
                                        Opacity="{Binding IsEnabled, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource BoolToOpacityConverter}}">
                                    <ContentPresenter HorizontalAlignment="Center"
                                                      VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsEnabled" Value="True">
                                        <Setter TargetName="border" Property="Background" Value="#3498DB"/>
                                    </Trigger>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="border" Property="Background" Value="#2980B9"/>
                                    </Trigger>
                                    <Trigger Property="IsPressed" Value="True">
                                        <Setter TargetName="border" Property="Background" Value="#2471A3"/>
                                    </Trigger>
                                    <Trigger Property="IsEnabled" Value="False">
                                        <Setter TargetName="border" Property="Background" Value="#95A5A6"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ===== ⑥ 底部状态栏 ===== -->
        <Border Grid.Row="6"
                Background="#F8F9FA"
                CornerRadius="4"
                BorderBrush="#DEE2E6"
                BorderThickness="1"
                Padding="12,8"
                Margin="0,8,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0"
                           Text="{Binding TotalCountText}"
                           FontSize="14" FontWeight="SemiBold"
                           Foreground="#2C3E50"
                           VerticalAlignment="Center"/>
                <TextBlock Grid.Column="1"
                           Text="提示：输入检索条件后点击「检索」查看数据，扫描枪扫码可自动填充机种名称和序列号"
                           FontSize="12" Foreground="#95A5A6"
                           VerticalAlignment="Center"/>
            </Grid>
        </Border>
    </Grid>
</UserControl>