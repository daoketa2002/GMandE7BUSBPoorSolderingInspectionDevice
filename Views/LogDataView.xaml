<UserControl x:Class="GMandE7BUSBPoorSolderingInspectionDevice.Views.LogDataView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:GMandE7BUSBPoorSolderingInspectionDevice.Views"
             xmlns:vm="clr-namespace:GMandE7BUSBPoorSolderingInspectionDevice.ViewModels"
             xmlns:converters="clr-namespace:GMandE7BUSBPoorSolderingInspectionDevice.Common.Converters"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:LogDataViewModel}"
             d:DesignWidth="1200" d:DesignHeight="700"
             FontFamily="Microsoft YaHei"
             Background="White">

    <UserControl.Resources>
        <converters:JudgmentToBackgroundConverter x:Key="JudgmentToBackgroundConverter"/>
        <converters:JudgmentToForegroundConverter x:Key="JudgmentToForegroundConverter"/>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
    </UserControl.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ===== 标题栏 ===== -->
        <Border Grid.Row="0"
                Background="#2C3E50"
                CornerRadius="8"
                Padding="16,12"
                Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="📊 " FontSize="24" Foreground="White" VerticalAlignment="Center"/>
                    <TextBlock Text="日志数据"
                               FontSize="24" FontWeight="Bold"
                               Foreground="White" VerticalAlignment="Center"/>
                    <TextBlock Text=" — 检测结果浏览与检索"
                               FontSize="14" Foreground="#BDC3C7"
                               VerticalAlignment="Center" Margin="12,0,0,0"/>
                </StackPanel>
                <Button Grid.Column="1"
                        Content="↩ 返回主菜单"
                        Command="{Binding GoBackCommand}"
                        Width="130" Height="40"
                        FontSize="14" FontWeight="Bold"
                        Foreground="White" Background="#95A5A6"
                        Cursor="Hand"
                        BorderThickness="0">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}"
                                    CornerRadius="6"
                                    BorderThickness="0">
                                <ContentPresenter HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </Grid>
        </Border>

        <!-- ===== 检索条件区 ===== -->
        <Border Grid.Row="1"
                Background="#F8F9FA"
                CornerRadius="8"
                BorderBrush="#DEE2E6"
                BorderThickness="1"
                Padding="16,12"
                Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="200"/>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="180"/>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="180"/>
                    <ColumnDefinition Width="30"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- 机种名称 -->
                <TextBlock Grid.Column="0" Text="机种名称：" VerticalAlignment="Center"
                           FontSize="14" FontWeight="SemiBold" Foreground="#495057"/>
                <ComboBox Grid.Column="1"
                          IsEditable="True"
                          Text="{Binding SelectedMachineType, UpdateSourceTrigger=PropertyChanged}"
                          ItemsSource="{Binding MachineTypes}"
                          Height="36" FontSize="14"
                          VerticalContentAlignment="Center"
                          ToolTip="可选择预设值或手动输入"/>

                <!-- 序列号 -->
                <TextBlock Grid.Column="3" Text="序列号：" VerticalAlignment="Center"
                           FontSize="14" FontWeight="SemiBold" Foreground="#495057"/>
                <TextBox Grid.Column="4"
                         Text="{Binding SearchSerialNumber, UpdateSourceTrigger=PropertyChanged}"
                         Height="36" FontSize="14"
                         VerticalContentAlignment="Center"
                         ToolTip="输入序列号进行检索（支持模糊匹配）"/>

                <!-- 方案名称 -->
                <TextBlock Grid.Column="6" Text="方案名称：" VerticalAlignment="Center"
                           FontSize="14" FontWeight="SemiBold" Foreground="#495057"/>
                <TextBox Grid.Column="7"
                         Text="{Binding SearchPlanName, UpdateSourceTrigger=PropertyChanged}"
                         Height="36" FontSize="14"
                         VerticalContentAlignment="Center"
                         ToolTip="输入方案名称进行检索（支持模糊匹配）"/>

                <!-- 按钮组 -->
                <StackPanel Grid.Column="9" Orientation="Horizontal">
                    <Button Content="🔍 检索"
                            Command="{Binding SearchCommand}"
                            Width="80" Height="36"
                            FontSize="14" FontWeight="Bold"
                            Foreground="White" Background="#3498DB"
                            Cursor="Hand" BorderThickness="0"
                            Margin="0,0,8,0"/>
                    <Button Content="↺ 重置"
                            Command="{Binding ResetCommand}"
                            Width="80" Height="36"
                            FontSize="14" FontWeight="Bold"
                            Foreground="White" Background="#E67E22"
                            Cursor="Hand" BorderThickness="0"
                            Margin="0,0,8,0"/>
                    <Button Content="📥 导出CSV"
                            Command="{Binding ExportToCsvCommand}"
                            Width="100" Height="36"
                            FontSize="14" FontWeight="Bold"
                            Foreground="White" Background="#27AE60"
                            Cursor="Hand" BorderThickness="0"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ===== 加载提示 ===== -->
        <Border Grid.Row="2"
                Background="#EBF5FB"
                CornerRadius="4"
                Padding="10,6"
                Margin="0,0,0,8"
                Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}">
            <TextBlock Text="⏳ 正在加载日志数据，请稍候..."
                       FontSize="14" Foreground="#2980B9"
                       HorizontalAlignment="Center"/>
        </Border>

        <!-- ===== 数据表格 ===== -->
        <DataGrid Grid.Row="3"
                  ItemsSource="{Binding LogDataList}"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  CanUserAddRows="False"
                  CanUserDeleteRows="False"
                  CanUserReorderColumns="False"
                  CanUserSortColumns="True"
                  SelectionMode="Extended"
                  SelectionUnit="FullRow"
                  GridLinesVisibility="Horizontal"
                  HorizontalGridLinesBrush="#E9ECEF"
                  RowHeaderWidth="0"
                  RowHeight="36"
                  ColumnHeaderHeight="40"
                  FontSize="13"
                  VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Auto"
                  Background="White"
                  BorderBrush="#DEE2E6"
                  BorderThickness="1"
                  x:Name="LogDataGrid">
            <DataGrid.Resources>
                <Style TargetType="DataGridColumnHeader">
                    <Setter Property="Background" Value="#34495E"/>
                    <Setter Property="Foreground" Value="White"/>
                    <Setter Property="FontWeight" Value="Bold"/>
                    <Setter Property="FontSize" Value="13"/>
                    <Setter Property="HorizontalContentAlignment" Value="Center"/>
                    <Setter Property="Padding" Value="8,0"/>
                    <Setter Property="BorderBrush" Value="#2C3E50"/>
                    <Setter Property="BorderThickness" Value="0,0,0,2"/>
                </Style>
                <Style TargetType="DataGridRow">
                    <Setter Property="Background" Value="White"/>
                    <Style.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="#EBF5FB"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="Background" Value="#D4E6F1"/>
                        </Trigger>
                    </Style.Triggers>
                </Style>
                <Style TargetType="DataGridCell">
                    <Setter Property="VerticalContentAlignment" Value="Center"/>
                    <Setter Property="HorizontalContentAlignment" Value="Center"/>
                    <Setter Property="Padding" Value="6,0"/>
                    <Setter Property="BorderBrush" Value="#E9ECEF"/>
                    <Setter Property="BorderThickness" Value="0,0,0,0"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="DataGridCell">
                                <Border Background="{TemplateBinding Background}"
                                        BorderBrush="{TemplateBinding BorderBrush}"
                                        BorderThickness="{TemplateBinding BorderThickness}"
                                        Padding="{TemplateBinding Padding}">
                                    <ContentPresenter VerticalAlignment="Center"
                                                      HorizontalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </DataGrid.Resources>

            <DataGrid.Columns>
                <DataGridTextColumn Header="序号"
                                    Binding="{Binding Index}"
                                    Width="60"/>
                <DataGridTextColumn Header="机种名称"
                                    Binding="{Binding MachineType}"
                                    Width="100"/>
                <DataGridTextColumn Header="序列号"
                                    Binding="{Binding SerialNumber}"
                                    Width="140"/>
                <DataGridTextColumn Header="方案名称"
                                    Binding="{Binding PlanName}"
                                    Width="120"/>
                <DataGridTextColumn Header="检查者"
                                    Binding="{Binding Inspector}"
                                    Width="90"/>
                <DataGridTemplateColumn Header="综合判定" Width="90">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Border CornerRadius="4"
                                    Padding="8,3"
                                    HorizontalAlignment="Center"
                                    Background="{Binding Judgment, Converter={StaticResource JudgmentToBackgroundConverter}}">
                                <TextBlock Text="{Binding Judgment}"
                                           FontWeight="Bold"
                                           FontSize="13"
                                           Foreground="{Binding Judgment, Converter={StaticResource JudgmentToForegroundConverter}}"
                                           HorizontalAlignment="Center"/>
                            </Border>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>

        <!-- ===== 底部状态栏 ===== -->
        <Border Grid.Row="4"
                Background="#F8F9FA"
                CornerRadius="4"
                BorderBrush="#DEE2E6"
                BorderThickness="1"
                Padding="12,8"
                Margin="0,8,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0"
                           Text="{Binding TotalCountText}"
                           FontSize="14" FontWeight="SemiBold"
                           Foreground="#2C3E50"
                           VerticalAlignment="Center"/>
                <TextBlock Grid.Column="1"
                           Text="提示：支持 Ctrl+C 复制选中单元格，支持列排序"
                           FontSize="12" Foreground="#95A5A6"
                           VerticalAlignment="Center"/>
            </Grid>
        </Border>
    </Grid>
</UserControl>