<Window x:Class="GMandE7BUSBPoorSolderingInspectionDevice.Views.ScannerRecoveryDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="扫描枪连接恢复"
        Width="620"
        Height="430"
        MinWidth="560"
        MinHeight="360"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#F4F6F8"
        FontFamily="Microsoft YaHei UI">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="扫描枪连接恢复"
                   FontSize="24"
                   FontWeight="Bold"
                   Foreground="#2C3E50"
                   Margin="0,0,0,18" />

        <Border Grid.Row="1" Background="White" CornerRadius="8" Padding="16" Margin="0,0,0,14">
            <TextBlock Text="{Binding StatusText}"
                       TextWrapping="Wrap"
                       FontSize="16"
                       Foreground="#34495E" />
        </Border>

        <StackPanel Grid.Row="2">
            <TextBlock Text="扫码内容：" FontSize="15" FontWeight="SemiBold" Foreground="#2C3E50" />
            <TextBox Text="{Binding BarcodeText}"
                     IsReadOnly="True"
                     TextWrapping="Wrap"
                     VerticalScrollBarVisibility="Auto"
                     MinHeight="70"
                     Margin="0,8,0,12"
                     FontFamily="Consolas"
                     FontSize="15" />
            <TextBlock Text="{Binding ReceiveStatusText}"
                       TextWrapping="Wrap"
                       FontSize="14"
                       Foreground="#566573" />
        </StackPanel>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button Content="关闭"
                    Command="{Binding CloseDialogCommand}"
                    Width="110"
                    Height="38"
                    Margin="0,0,10,0" />
            <Button Content="深度恢复"
                    Command="{Binding DeepRecoverCommand}"
                    Width="130"
                    Height="38"
                    Background="#C0392B"
                    Foreground="White" />
        </StackPanel>
    </Grid>
</Window>
