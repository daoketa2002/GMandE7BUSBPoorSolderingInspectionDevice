<UserControl x:Class="GMandE7BUSBPoorSolderingInspectionDevice.Views.PlanSettingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:vm="clr-namespace:GMandE7BUSBPoorSolderingInspectionDevice.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:PlanSettingViewModel}"
             d:DesignWidth="1100" d:DesignHeight="650"
             FontFamily="Microsoft YaHei"
             Background="White">

    <UserControl.Resources>
        <!-- 通用按钮样式 -->
        <Style x:Key="ActionButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="120"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="6"
                                BorderThickness="0">
                            <ContentPresenter HorizontalAlignment="Center"
                                            VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Opacity" Value="0.85"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.5"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- DataGrid 样式 -->
        <Style x:Key="PlanDataGridStyle" TargetType="DataGrid">
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="RowHeight" Value="40"/>
            <Setter Property="ColumnHeaderHeight" Value="42"/>
            <Setter Property="GridLinesVisibility" Value="All"/>
            <Setter Property="HorizontalGridLinesBrush" Value="#DEE2E6"/>
            <Setter Property="VerticalGridLinesBrush" Value="#DEE2E6"/>
            <Setter Property="BorderBrush" Value="#CED4DA"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="CanUserDeleteRows" Value="False"/>
            <Setter Property="CanUserReorderColumns" Value="False"/>
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="AutoGenerateColumns" Value="False"/>
            <Setter Property="SelectionMode" Value="Single"/>
            <Setter Property="RowBackground" Value="White"/>
            <Setter Property="AlternatingRowBackground" Value="#F8F9FA"/>
        </Style>

        <Style x:Key="DataGridColumnHeaderStyle" TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#2C3E50"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="BorderBrush" Value="#1A252F"/>
            <Setter Property="BorderThickness" Value="0,0,0,2"/>
        </Style>

        <Style x:Key="DataGridCellCenterStyle" TargetType="DataGridCell">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="BorderBrush" Value="#DEE2E6"/>
            <Setter Property="BorderThickness" Value="0.5"/>
        </Style>
    </UserControl.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ===== 顶部标题栏 ===== -->
        <Border Grid.Row="0" Background="#2C3E50" CornerRadius="8" Padding="16,12" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="📋 " FontSize="24" Foreground="White" VerticalAlignment="Center"/>
                    <TextBlock Text="方案设定" FontSize="24" FontWeight="Bold" Foreground="White" VerticalAlignment="Center"/>
                    <TextBlock Text=" — 管理检测方案" FontSize="14" Foreground="#BDC3C7" VerticalAlignment="Center" Margin="12,0,0,0"/>
                </StackPanel>
                <Button Grid.Column="1" Style="{StaticResource ActionButtonStyle}"
                        Width="130" Background="#95A5A6"
                        Content="↩ 返回主菜单"
                        Command="{Binding GoBackCommand}"
                        VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <!-- ===== 检索区域 ===== -->
        <Border Grid.Row="1" Background="#F8F9FA" CornerRadius="8" BorderBrush="#DEE2E6" BorderThickness="1" Padding="14,12" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="200"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="200"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="200"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="系列：" FontSize="15" FontWeight="Bold" Foreground="#495057" VerticalAlignment="Center" Margin="0,0,6,0"/>
                <ComboBox Grid.Column="1" IsEditable="True" Text="{Binding FilterSeries, UpdateSourceTrigger=PropertyChanged}"
                          ItemsSource="{Binding SeriesOptions}" FontSize="15" Height="34" VerticalContentAlignment="Center"/>

                <TextBlock Grid.Column="2" Text="型号：" FontSize="15" FontWeight="Bold" Foreground="#495057" VerticalAlignment="Center" Margin="12,0,6,0"/>
                <ComboBox Grid.Column="3" IsEditable="True" Text="{Binding FilterModel, UpdateSourceTrigger=PropertyChanged}"
                          ItemsSource="{Binding ModelOptions}" FontSize="15" Height="34" VerticalContentAlignment="Center"/>

                <TextBlock Grid.Column="4" Text="方案名：" FontSize="15" FontWeight="Bold" Foreground="#495057" VerticalAlignment="Center" Margin="12,0,6,0"/>
                <TextBox Grid.Column="5" Text="{Binding FilterPlanName, UpdateSourceTrigger=PropertyChanged}"
                         FontSize="15" Height="34" VerticalContentAlignment="Center" BorderBrush="#CED4DA"/>

                <Button Grid.Column="6" Style="{StaticResource ActionButtonStyle}" Width="80" Background="#3498DB"
                        Content="🔍 检索" Command="{Binding SearchCommand}" Margin="12,0,6,0"/>
                <Button Grid.Column="7" Style="{StaticResource ActionButtonStyle}" Width="80" Background="#95A5A6"
                        Content="清空" Command="{Binding ClearFilterCommand}" HorizontalAlignment="Left"/>
            </Grid>
        </Border>

        <!-- ===== 方案列表表格 ===== -->
        <DataGrid Grid.Row="2" ItemsSource="{Binding Plans}" SelectedItem="{Binding SelectedPlan}"
                  Style="{StaticResource PlanDataGridStyle}" ColumnHeaderStyle="{StaticResource DataGridColumnHeaderStyle}"
                  Margin="0,0,0,12">
            <DataGrid.Columns>
                <DataGridTextColumn Header="系列" Binding="{Binding Series}" Width="120">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                            <Setter Property="HorizontalAlignment" Value="Center"/>
                            <Setter Property="VerticalAlignment" Value="Center"/>
                            <Setter Property="FontSize" Value="15"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>

                <DataGridTextColumn Header="型号" Binding="{Binding Model}" Width="200">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                            <Setter Property="HorizontalAlignment" Value="Center"/>
                            <Setter Property="VerticalAlignment" Value="Center"/>
                            <Setter Property="FontSize" Value="15"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>

                <DataGridTextColumn Header="方案名称" Binding="{Binding PlanName}" Width="*">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                            <Setter Property="HorizontalAlignment" Value="Center"/>
                            <Setter Property="VerticalAlignment" Value="Center"/>
                            <Setter Property="FontSize" Value="15"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>

                <DataGridTextColumn Header="项目数" Binding="{Binding Items.Count}" Width="100">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                            <Setter Property="HorizontalAlignment" Value="Center"/>
                            <Setter Property="VerticalAlignment" Value="Center"/>
                            <Setter Property="FontSize" Value="14"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
            </DataGrid.Columns>
        </DataGrid>

        <!-- ===== 底部操作区 ===== -->
        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- 统计信息 -->
            <Border Grid.Column="0" Background="#E9ECEF" CornerRadius="6" Padding="14,8">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{Binding TotalCountText}" FontSize="14" FontWeight="SemiBold" Foreground="#2C3E50" VerticalAlignment="Center"/>
                    <TextBlock Text="  |  当前方案: " FontSize="14" Foreground="#6C757D" VerticalAlignment="Center" Margin="10,0,0,0"/>
                    <TextBlock Text="{Binding CurrentPlanDisplay}" FontSize="14" FontWeight="Bold" Foreground="#27AE60" VerticalAlignment="Center"/>
                </StackPanel>
            </Border>

            <!-- 操作按钮 -->
            <UniformGrid Grid.Column="2" Rows="1" Columns="5" HorizontalAlignment="Right">
                <Button Style="{StaticResource ActionButtonStyle}" Background="#3498DB" Content="➕ 新增"
                        Command="{Binding AddPlanCommand}" Margin="4,0"/>
                <Button Style="{StaticResource ActionButtonStyle}" Background="#F39C12" Content="✏️ 编辑"
                        Command="{Binding EditPlanCommand}" Margin="4,0"/>
                <Button Style="{StaticResource ActionButtonStyle}" Background="#E74C3C" Content="🗑 删除"
                        Command="{Binding DeletePlanCommand}" Margin="4,0"/>
                <Button Style="{StaticResource ActionButtonStyle}" Background="#27AE60" Content="⭐ 设为当前"
                        Command="{Binding SetAsCurrentPlanCommand}" Margin="4,0" Width="130"/>
            </UniformGrid>
        </Grid>
    </Grid>
</UserControl>