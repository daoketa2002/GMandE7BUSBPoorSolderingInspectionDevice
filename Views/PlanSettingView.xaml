<UserControl x:Class="GMandE7BUSBPoorSolderingInspectionDevice.Views.PlanSettingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:vm="clr-namespace:GMandE7BUSBPoorSolderingInspectionDevice.ViewModels"
             xmlns:converters="clr-namespace:GMandE7BUSBPoorSolderingInspectionDevice.Common.Converters"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:PlanSettingViewModel}"
             d:DesignWidth="1100" d:DesignHeight="650"
             FontFamily="Microsoft YaHei"
             Background="White">

    <UserControl.Resources>
        <!-- Bool转Visibility转换器 -->
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>

        <!-- 通用按钮样式 -->
        <Style x:Key="ActionButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="120"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="6"
                                BorderThickness="0">
                            <ContentPresenter HorizontalAlignment="Center"
                                            VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Opacity" Value="0.85"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.5"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- DataGrid 样式 -->
        <Style x:Key="PlanDataGridStyle" TargetType="DataGrid">
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="RowHeight" Value="40"/>
            <Setter Property="ColumnHeaderHeight" Value="42"/>
            <Setter Property="GridLinesVisibility" Value="All"/>
            <Setter Property="HorizontalGridLinesBrush" Value="#DEE2E6"/>
            <Setter Property="VerticalGridLinesBrush" Value="#DEE2E6"/>
            <Setter Property="BorderBrush" Value="#CED4DA"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="CanUserDeleteRows" Value="False"/>
            <Setter Property="CanUserReorderColumns" Value="False"/>
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="AutoGenerateColumns" Value="False"/>
            <Setter Property="SelectionMode" Value="Single"/>
            <Setter Property="RowBackground" Value="White"/>
            <Setter Property="AlternatingRowBackground" Value="#F8F9FA"/>
        </Style>

        <Style x:Key="DataGridColumnHeaderStyle" TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#2C3E50"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="BorderBrush" Value="#1A252F"/>
            <Setter Property="BorderThickness" Value="0,0,0,2"/>
        </Style>

        <Style x:Key="DataGridCellCenterStyle" TargetType="DataGridCell">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="BorderBrush" Value="#DEE2E6"/>
            <Setter Property="BorderThickness" Value="0.5"/>
        </Style>
    </UserControl.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- 0: 顶部标题栏 -->
            <RowDefinition Height="Auto"/>
            <!-- 1: 检索区域 -->
            <RowDefinition Height="Auto"/>
            <!-- 2: 扫描枪状态栏 -->
            <RowDefinition Height="*"/>
            <!-- 3: 方案列表表格 -->
            <RowDefinition Height="Auto"/>
            <!-- 4: 底部操作区 -->
        </Grid.RowDefinitions>

        <!-- ===== 顶部标题栏 ===== -->
        <Border Grid.Row="0" Background="#2C3E50" CornerRadius="8" Padding="16,12" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="📋 " FontSize="24" Foreground="White" VerticalAlignment="Center"/>
                    <TextBlock Text="方案设定" FontSize="24" FontWeight="Bold" Foreground="White" VerticalAlignment="Center"/>
                    <TextBlock Text=" — 管理检测方案" FontSize="14" Foreground="#BDC3C7" VerticalAlignment="Center" Margin="12,0,0,0"/>
                </StackPanel>
                <Button Grid.Column="1" Style="{StaticResource ActionButtonStyle}"
                        Width="130" Background="#95A5A6"
                        Content="↩ 返回主菜单"
                        Command="{Binding GoBackCommand}"
                        VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <!-- ===== 检索区域 ===== -->
        <!-- 改动说明：第一列标签从"系列"改为"机种" -->
        <Border Grid.Row="1" Background="#F8F9FA" CornerRadius="8" BorderBrush="#DEE2E6" BorderThickness="1" Padding="14,12" Margin="0,0,0,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="200"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="200"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="200"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- 机种选择（ComboBox可编辑，支持手动输入和下拉选择） -->
                <TextBlock Grid.Column="0" Text="机种：" FontSize="15" FontWeight="Bold" Foreground="#495057" VerticalAlignment="Center" Margin="0,0,6,0"/>
                <ComboBox Grid.Column="1" IsEditable="True" Text="{Binding SelectedMachineType, UpdateSourceTrigger=PropertyChanged}"
                          ItemsSource="{Binding MachineTypeOptions}" FontSize="15" Height="34" VerticalContentAlignment="Center"/>

                <!-- 方案选择（ComboBox可编辑，与机种联动） -->
                <TextBlock Grid.Column="2" Text="方案名：" FontSize="15" FontWeight="Bold" Foreground="#495057" VerticalAlignment="Center" Margin="12,0,6,0"/>
                <ComboBox Grid.Column="3" IsEditable="True" Text="{Binding SelectedPlanName, UpdateSourceTrigger=PropertyChanged}"
                          ItemsSource="{Binding PlanNameOptions}" FontSize="15" Height="34" VerticalContentAlignment="Center"/>

                <Button Grid.Column="4" Style="{StaticResource ActionButtonStyle}" Width="80" Background="#3498DB"
                        Content="🔍 检索" Command="{Binding SearchCommand}" Margin="12,0,6,0" HorizontalAlignment="Left"/>
                <Button Grid.Column="5" Style="{StaticResource ActionButtonStyle}" Width="80" Background="#95A5A6"
                        Content="清空" Command="{Binding ClearFilterCommand}" HorizontalAlignment="Left"/>
            </Grid>
        </Border>

        <!-- ===== 扫描枪状态栏 ===== -->
        <Border Grid.Row="2" CornerRadius="6" BorderThickness="1" Padding="10,6" Margin="0,0,0,8">
            <Border.Style>
                <Style TargetType="Border">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsScannerConnected}" Value="True">
                            <Setter Property="Background" Value="#FFF3CD"/>
                            <Setter Property="BorderBrush" Value="#FFEAA7"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding IsScannerConnected}" Value="False">
                            <Setter Property="Background" Value="#E9ECEF"/>
                            <Setter Property="BorderBrush" Value="#CED4DA"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- 连接状态图标+文本 -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock FontSize="16" VerticalAlignment="Center">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsScannerConnected}" Value="True">
                                        <Setter Property="Text" Value="📷"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsScannerConnected}" Value="False">
                                        <Setter Property="Text" Value="📴"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <TextBlock VerticalAlignment="Center" FontSize="14" FontWeight="Bold" Margin="4,0,0,0">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsScannerConnected}" Value="True">
                                        <Setter Property="Text" Value="扫描枪已连接"/>
                                        <Setter Property="Foreground" Value="#856404"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsScannerConnected}" Value="False">
                                        <Setter Property="Text" Value="扫描枪未连接"/>
                                        <Setter Property="Foreground" Value="#6C757D"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>

                <!-- 最近扫描条码 -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="20,0,0,0"
                    Visibility="{Binding IsScannerConnected, Converter={StaticResource BoolToVisibilityConverter}}">
                    <TextBlock Text="最近扫描: " FontSize="13" Foreground="#856404" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding ScannedBarcode}" FontSize="13" FontWeight="Bold"
                       Foreground="#856404" VerticalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ===== 方案列表表格 ===== -->
        <!-- 改动说明：表头从"系列"改为"机种" -->
        <DataGrid Grid.Row="3" ItemsSource="{Binding FilteredPlans}" SelectedItem="{Binding SelectedPlan}"
                  Style="{StaticResource PlanDataGridStyle}" ColumnHeaderStyle="{StaticResource DataGridColumnHeaderStyle}"
                  Margin="0,0,0,12">
            <DataGrid.Columns>
                <!-- 机种列 -->
                <DataGridTextColumn Header="机种" Binding="{Binding MachineType}" Width="180">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                            <Setter Property="HorizontalAlignment" Value="Center"/>
                            <Setter Property="VerticalAlignment" Value="Center"/>
                            <Setter Property="FontSize" Value="15"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>

                <!-- 方案名称列 -->
                <DataGridTextColumn Header="方案名称" Binding="{Binding PlanName}" Width="*">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                            <Setter Property="HorizontalAlignment" Value="Center"/>
                            <Setter Property="VerticalAlignment" Value="Center"/>
                            <Setter Property="FontSize" Value="15"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>

                <!-- 项目数列 -->
                <DataGridTextColumn Header="项目数" Binding="{Binding Items.Count}" Width="100">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                            <Setter Property="HorizontalAlignment" Value="Center"/>
                            <Setter Property="VerticalAlignment" Value="Center"/>
                            <Setter Property="FontSize" Value="14"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>

                <!-- 最后修改时间列 -->
                <DataGridTextColumn Header="最后修改时间" Binding="{Binding LastModifiedTime, StringFormat='yyyy-MM-dd HH:mm:ss'}" Width="180">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                            <Setter Property="HorizontalAlignment" Value="Center"/>
                            <Setter Property="VerticalAlignment" Value="Center"/>
                            <Setter Property="FontSize" Value="13"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
            </DataGrid.Columns>
        </DataGrid>

        <!-- ===== 底部操作区 ===== -->
        <Grid Grid.Row="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- 统计信息 -->
            <Border Grid.Column="0" Background="#E9ECEF" CornerRadius="6" Padding="14,8">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{Binding TotalCountText}" FontSize="14" FontWeight="SemiBold" Foreground="#2C3E50" VerticalAlignment="Center"/>
                </StackPanel>
            </Border>

            <!-- 操作按钮 -->
            <UniformGrid Grid.Column="2" Rows="1" Columns="3" HorizontalAlignment="Right">
                <Button Style="{StaticResource ActionButtonStyle}" Background="#3498DB" Content="➕ 新增"
                        Command="{Binding AddPlanCommand}" Margin="4,0"/>
                <Button Style="{StaticResource ActionButtonStyle}" Background="#F39C12" Content="✏️ 编辑"
                        Command="{Binding EditPlanCommand}" Margin="4,0"/>
                <Button Style="{StaticResource ActionButtonStyle}" Background="#E74C3C" Content="🗑 删除"
                        Command="{Binding DeletePlanCommand}" Margin="4,0"/>
            </UniformGrid>
        </Grid>
    </Grid>
</UserControl>