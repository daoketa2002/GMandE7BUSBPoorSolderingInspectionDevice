<UserControl x:Class="GMandE7BUSBPoorSolderingInspectionDevice.Views.PlanEditView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:vm="clr-namespace:GMandE7BUSBPoorSolderingInspectionDevice.ViewModels"
             xmlns:converters="clr-namespace:GMandE7BUSBPoorSolderingInspectionDevice.Common.Converters"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:PlanEditViewModel}"
             d:DesignWidth="1100" d:DesignHeight="700"
             FontFamily="Microsoft YaHei"
             Background="White">

    <UserControl.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>

        <Style x:Key="ActionButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="100"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="5"
                                BorderThickness="0">
                            <ContentPresenter HorizontalAlignment="Center"
                                            VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Opacity" Value="0.85"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.5"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ItemDataGridStyle" TargetType="DataGrid">
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="RowHeight" Value="38"/>
            <Setter Property="ColumnHeaderHeight" Value="40"/>
            <Setter Property="GridLinesVisibility" Value="All"/>
            <Setter Property="HorizontalGridLinesBrush" Value="#DEE2E6"/>
            <Setter Property="VerticalGridLinesBrush" Value="#DEE2E6"/>
            <Setter Property="BorderBrush" Value="#CED4DA"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="CanUserDeleteRows" Value="False"/>
            <Setter Property="CanUserReorderColumns" Value="False"/>
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="AutoGenerateColumns" Value="False"/>
            <Setter Property="SelectionMode" Value="Single"/>
            <Setter Property="RowBackground" Value="White"/>
            <Setter Property="AlternatingRowBackground" Value="#F8F9FA"/>
        </Style>

        <Style x:Key="ItemColumnHeaderStyle" TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#2C3E50"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="BorderBrush" Value="#1A252F"/>
            <Setter Property="BorderThickness" Value="0,0,0,2"/>
        </Style>
    </UserControl.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- 0: 顶部标题栏 -->
            <RowDefinition Height="Auto"/>
            <!-- 1: 基本信息区 -->
            <RowDefinition Height="Auto"/>
            <!-- 2: 扫描枪状态栏 -->
            <RowDefinition Height="*"/>
            <!-- 3: 项目列表区 -->
            <RowDefinition Height="Auto"/>
            <!-- 4: 底部按钮区 -->
        </Grid.RowDefinitions>

        <!-- ===== 顶部标题栏 ===== -->
        <Border Grid.Row="0" Background="#2C3E50" CornerRadius="8" Padding="16,12" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="📝 " FontSize="24" Foreground="White" VerticalAlignment="Center"/>
                    <TextBlock Text="编辑方案" FontSize="24" FontWeight="Bold" Foreground="White" VerticalAlignment="Center"/>
                    <TextBlock Text=" — 配置检测项目" FontSize="14" Foreground="#BDC3C7" VerticalAlignment="Center" Margin="12,0,0,0"/>
                </StackPanel>
                <Button Grid.Column="1" Style="{StaticResource ActionButtonStyle}"
                        Width="130" Background="#95A5A6"
                        Content="↩ 返回"
                        Command="{Binding GoBackCommand}"
                        VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <!-- ===== 基本信息区 ===== -->
        <!-- 改动说明：标签从"★ 系列"改为"★ 机种"，从"机种名称"改为"方案名称" -->
        <Border Grid.Row="1" Background="#F8F9FA" CornerRadius="8" BorderBrush="#DEE2E6" BorderThickness="1" Padding="14,12" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="180"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="200"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- 机种输入（必填，带★标记） -->
                <TextBlock Grid.Column="0" Text="★ 机种：" FontSize="15" FontWeight="Bold" Foreground="#E74C3C" VerticalAlignment="Center" Margin="0,0,6,0"/>
                <ComboBox Grid.Column="1" IsEditable="True" Text="{Binding MachineType, UpdateSourceTrigger=PropertyChanged}"
                          ItemsSource="{Binding MachineTypeOptions}" FontSize="15" Height="34" VerticalContentAlignment="Center"/>

                <!-- 方案名称（必填，带★标记） -->
                <TextBlock Grid.Column="2" Text="★ 方案名称：" FontSize="15" FontWeight="Bold" Foreground="#E74C3C" VerticalAlignment="Center" Margin="12,0,6,0"/>
                <TextBox Grid.Column="3" Text="{Binding PlanName, UpdateSourceTrigger=PropertyChanged}"
                         FontSize="15" Height="34" VerticalContentAlignment="Center" BorderBrush="#CED4DA"/>

                <!-- 时间戳信息（只读展示） -->
                <TextBlock Grid.Column="4" Text="创建：" FontSize="13" Foreground="#6C757D" VerticalAlignment="Center" Margin="12,0,4,0"/>
                <TextBlock Grid.Column="5" Text="{Binding CreatedTime, StringFormat='yyyy-MM-dd HH:mm:ss'}" FontSize="13" Foreground="#6C757D" VerticalAlignment="Center" Width="150"/>

                <TextBlock Grid.Column="6" Text="修改：" FontSize="13" Foreground="#6C757D" VerticalAlignment="Center" Margin="8,0,4,0"/>
                <TextBlock Grid.Column="7" Text="{Binding LastModifiedTime, StringFormat='yyyy-MM-dd HH:mm:ss'}" FontSize="13" Foreground="#6C757D" VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <!-- ===== 扫描枪状态栏 ===== -->
        <Border Grid.Row="2" CornerRadius="6" BorderThickness="1" Padding="10,6" Margin="0,0,0,8">
            <Border.Style>
                <Style TargetType="Border">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsScannerConnected}" Value="True">
                            <Setter Property="Background" Value="#FFF3CD"/>
                            <Setter Property="BorderBrush" Value="#FFEAA7"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding IsScannerConnected}" Value="False">
                            <Setter Property="Background" Value="#E9ECEF"/>
                            <Setter Property="BorderBrush" Value="#CED4DA"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock FontSize="16" VerticalAlignment="Center">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsScannerConnected}" Value="True">
                                        <Setter Property="Text" Value="📷"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsScannerConnected}" Value="False">
                                        <Setter Property="Text" Value="📴"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <TextBlock VerticalAlignment="Center" FontSize="14" FontWeight="Bold" Margin="4,0,0,0">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsScannerConnected}" Value="True">
                                        <Setter Property="Text" Value="扫描枪已连接 — 扫码自动填充机种名称"/>
                                        <Setter Property="Foreground" Value="#856404"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsScannerConnected}" Value="False">
                                        <Setter Property="Text" Value="扫描枪未连接"/>
                                        <Setter Property="Foreground" Value="#6C757D"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="20,0,0,0"
                    Visibility="{Binding IsScannerConnected, Converter={StaticResource BoolToVisibilityConverter}}">
                    <TextBlock Text="最近扫描: " FontSize="13" Foreground="#856404" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding ScannedBarcode}" FontSize="13" FontWeight="Bold"
                       Foreground="#856404" VerticalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ===== 项目列表区 ===== -->
        <Grid Grid.Row="3" Margin="0,0,0,12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- 项目表头 -->
            <Border Grid.Row="0" Background="#34495E" CornerRadius="6,6,0,0" Padding="10,8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="📋 检测项目列表" FontSize="16" FontWeight="Bold" Foreground="White" VerticalAlignment="Center"/>
                    <UniformGrid Grid.Column="1" Rows="1" Columns="4">
                        <Button Style="{StaticResource ActionButtonStyle}" Width="90" Background="#27AE60"
                                Content="⬆ 上移" Command="{Binding MoveItemUpCommand}" Margin="2,0"/>
                        <Button Style="{StaticResource ActionButtonStyle}" Width="90" Background="#F39C12"
                                Content="⬇ 下移" Command="{Binding MoveItemDownCommand}" Margin="2,0"/>
                        <Button Style="{StaticResource ActionButtonStyle}" Width="90" Background="#3498DB"
                                Content="➕ 新增项目" Command="{Binding AddItemCommand}" Margin="2,0"/>
                        <Button Style="{StaticResource ActionButtonStyle}" Width="90" Background="#E74C3C"
                                Content="🗑 删除项目" Command="{Binding DeleteItemCommand}" Margin="2,0"/>
                    </UniformGrid>
                </Grid>
            </Border>

            <!-- 项目DataGrid -->
            <DataGrid Grid.Row="1" ItemsSource="{Binding Items}" SelectedItem="{Binding SelectedItem}"
                      Style="{StaticResource ItemDataGridStyle}" ColumnHeaderStyle="{StaticResource ItemColumnHeaderStyle}">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="序号" Binding="{Binding Index}" Width="70">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="HorizontalAlignment" Value="Center"/>
                                <Setter Property="VerticalAlignment" Value="Center"/>
                                <Setter Property="FontSize" Value="15"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <DataGridTemplateColumn Header="引脚(左)" Width="150">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <ComboBox IsEditable="True"
                                          Text="{Binding PinLeft, UpdateSourceTrigger=PropertyChanged}"
                                          ItemsSource="{Binding DataContext.PinOptions, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                          FontSize="15"
                                          Height="30"
                                          VerticalContentAlignment="Center"
                                          BorderThickness="1"
                                          BorderBrush="#CED4DA"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTextColumn Header="" Width="30" IsReadOnly="True">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="HorizontalAlignment" Value="Center"/>
                                <Setter Property="VerticalAlignment" Value="Center"/>
                                <Setter Property="FontSize" Value="18"/>
                                <Setter Property="FontWeight" Value="ExtraBold"/>
                                <Setter Property="Foreground" Value="#2C3E50"/>
                                <Setter Property="Text" Value="-"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <DataGridTemplateColumn Header="引脚(右)" Width="150">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <ComboBox IsEditable="True"
                                          Text="{Binding PinRight, UpdateSourceTrigger=PropertyChanged}"
                                          ItemsSource="{Binding DataContext.PinOptions, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                          FontSize="15"
                                          Height="30"
                                          VerticalContentAlignment="Center"
                                          BorderThickness="1"
                                          BorderBrush="#CED4DA"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTextColumn Header="项目名称" Width="180">
                        <DataGridTextColumn.Binding>
                            <MultiBinding StringFormat="{}{0}-{1}">
                                <Binding Path="PinLeft"/>
                                <Binding Path="PinRight"/>
                            </MultiBinding>
                        </DataGridTextColumn.Binding>
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="HorizontalAlignment" Value="Center"/>
                                <Setter Property="VerticalAlignment" Value="Center"/>
                                <Setter Property="FontSize" Value="15"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                                <Setter Property="Foreground" Value="#2C3E50"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <DataGridTemplateColumn Header="检查方式" Width="150">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <ComboBox IsEditable="True"
                                          IsReadOnly="True"
                                          Text="{Binding CheckMode, UpdateSourceTrigger=PropertyChanged}"
                                          ItemsSource="{Binding DataContext.CheckModeOptions, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                          FontSize="15"
                                          Height="30"
                                          VerticalContentAlignment="Center"
                                          BorderThickness="1"
                                          BorderBrush="#CED4DA"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTemplateColumn Header="下限 (Ω)" Width="130">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBox Text="{Binding LowerLimit, UpdateSourceTrigger=PropertyChanged, TargetNullValue=''}"
                                         IsEnabled="{Binding IsResistanceMode}"
                                         FontSize="15"
                                         Height="30"
                                         VerticalContentAlignment="Center"
                                         BorderThickness="1"
                                         BorderBrush="#CED4DA"
                                         HorizontalContentAlignment="Center">
                                    <TextBox.Style>
                                        <Style TargetType="TextBox">
                                            <Setter Property="Background" Value="White"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsResistanceMode}" Value="False">
                                                    <Setter Property="Background" Value="#E9ECEF"/>
                                                    <Setter Property="Foreground" Value="#ADB5BD"/>
                                                    <Setter Property="Text" Value=""/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBox.Style>
                                </TextBox>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTemplateColumn Header="上限 (Ω)" Width="130">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBox Text="{Binding UpperLimit, UpdateSourceTrigger=PropertyChanged, TargetNullValue=''}"
                                         IsEnabled="{Binding IsResistanceMode}"
                                         FontSize="15"
                                         Height="30"
                                         VerticalContentAlignment="Center"
                                         BorderThickness="1"
                                         BorderBrush="#CED4DA"
                                         HorizontalContentAlignment="Center">
                                    <TextBox.Style>
                                        <Style TargetType="TextBox">
                                            <Setter Property="Background" Value="White"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsResistanceMode}" Value="False">
                                                    <Setter Property="Background" Value="#E9ECEF"/>
                                                    <Setter Property="Foreground" Value="#ADB5BD"/>
                                                    <Setter Property="Text" Value=""/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBox.Style>
                                </TextBox>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTemplateColumn Header="单位" Width="120">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <ComboBox IsEditable="True"
                                          IsReadOnly="True"
                                          Text="{Binding Unit, UpdateSourceTrigger=PropertyChanged}"
                                          FontSize="15"
                                          Height="30"
                                          VerticalContentAlignment="Center"
                                          BorderThickness="1"
                                          BorderBrush="#CED4DA">
                                    <ComboBox.Style>
                                        <Style TargetType="ComboBox">
                                            <Setter Property="IsEnabled" Value="True"/>
                                            <Style.Triggers>
                                                <!-- 电阻模式固定为 Ω，下拉禁用 -->
                                                <DataTrigger Binding="{Binding CheckMode}" Value="Resistance">
                                                    <Setter Property="IsEnabled" Value="False"/>
                                                    <Setter Property="ItemsSource"
                                                            Value="{Binding DataContext.CheckModeOptions, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding CheckMode}" Value="Continuity">
                                                    <Setter Property="ItemsSource"
                                                            Value="{Binding DataContext.ContinuityUnitOptions, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </ComboBox.Style>
                                </ComboBox>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Grid>

        <!-- ===== 底部按钮区 ===== -->
        <Border Grid.Row="4" Background="#F8F9FA" CornerRadius="8" BorderBrush="#DEE2E6" BorderThickness="1" Padding="14,12">
            <UniformGrid Rows="1" Columns="2" HorizontalAlignment="Center">
                <Button Style="{StaticResource ActionButtonStyle}" Width="160" Height="44" Background="#27AE60"
                        Content="💾 保存方案" FontSize="17" Command="{Binding SavePlanCommand}" Margin="8,0"/>
                <Button Style="{StaticResource ActionButtonStyle}" Width="160" Height="44" Background="#95A5A6"
                        Content="↩ 返回" FontSize="17" Command="{Binding GoBackCommand}" Margin="8,0"/>
            </UniformGrid>
        </Border>
    </Grid>
</UserControl>